# Production environment template.
# Copy to `.env.production` on the server and fill in REAL secrets.
# `.env.production` is gitignored — never commit it.

# ====== App ======
APP_NAME=Family Care API
APP_ENV=production
APP_PORT=3000
APP_PREFIX=api/v1

# ====== Postgres container credentials (used by the `db` service) ======
POSTGRES_USER=familycare
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=familycare

# ====== App DB connection ======
# Host MUST be `db` (the compose service name), NOT localhost — the API talks
# to Postgres over the internal Docker network. Keep user/password/db in sync
# with POSTGRES_* above.
DATABASE_URL="postgresql://familycare:CHANGE_ME_strong_db_password@db:5432/familycare?schema=public"

# ====== JWT (use strong random values, different from local) ======
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_prod_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_prod_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ====== Security ======
BCRYPT_SALT_ROUNDS=12

# ====== Family invitations ======
INVITATION_EXPIRES_IN_DAYS=7

# ====== Email (xác thực tài khoản) ======
# Production KHUYẾN NGHỊ dùng Resend qua HTTP API (cổng 443) vì nhiều VPS (vd
# AZDIGI) chặn cổng SMTP outbound. Cần RESEND_API_KEY + MAIL_FROM.
# ⚠️ Gửi tới email khách hàng bất kỳ → BẮT BUỘC verify domain trong Resend và
# dùng sender no-reply@your-domain. onboarding@resend.dev chỉ dùng để test.
MAIL_PROVIDER=resend
MAIL_FROM=Family Care <no-reply@your-domain>
RESEND_API_KEY=CHANGE_ME_resend_api_key

# (Tùy chọn) Brevo thay thế: MAIL_PROVIDER=brevo + BREVO_API_KEY=...
# BREVO_API_KEY=
# (Tùy chọn) SMTP thay thế: MAIL_PROVIDER=smtp + SMTP_*:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ====== Email verification OTP ======
EMAIL_VERIFICATION_OTP_EXPIRES_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# ====== Stripe (subscription payments) ======
STRIPE_SECRET_KEY=CHANGE_ME_stripe_secret_key
STRIPE_WEBHOOK_SECRET=CHANGE_ME_stripe_webhook_secret
STRIPE_CHECKOUT_SUCCESS_URL=https://your-frontend/subscription/success
STRIPE_CHECKOUT_CANCEL_URL=https://your-frontend/subscription/cancel
# Stripe recurring (annual) Price id cho gói trả phí (dùng cho `npm run seed`).
STRIPE_PRICE_PLUS=CHANGE_ME_price_plus
STRIPE_PRICE_PREMIUM=CHANGE_ME_price_premium

# ====== Rate limit (throttler) ======
THROTTLE_TTL=60
THROTTLE_LIMIT=100
