# Production environment template.
# Copy to `.env.production` on the server and fill in REAL secrets.
# `.env.production` is gitignored — never commit it.

# ====== App ======
APP_NAME=Family Care API
APP_ENV=production
APP_PORT=3000
APP_PREFIX=api/v1

# ====== Postgres container credentials (used by the `db` service) ======
POSTGRES_USER=familycare
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=familycare

# ====== App DB connection ======
# Host MUST be `db` (the compose service name), NOT localhost — the API talks
# to Postgres over the internal Docker network. Keep user/password/db in sync
# with POSTGRES_* above.
DATABASE_URL="postgresql://familycare:CHANGE_ME_strong_db_password@db:5432/familycare?schema=public"

# ====== JWT (use strong random values, different from local) ======
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_prod_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_prod_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ====== Security ======
BCRYPT_SALT_ROUNDS=12

# ====== Email (xác thực tài khoản) ======
# Production KHUYẾN NGHỊ dùng Resend qua HTTP API (cổng 443) vì nhiều VPS (vd
# AZDIGI) chặn cổng SMTP outbound. Cần RESEND_API_KEY + MAIL_FROM.
# ⚠️ Gửi tới email khách hàng bất kỳ → BẮT BUỘC verify domain trong Resend và
# dùng sender no-reply@your-domain. onboarding@resend.dev chỉ dùng để test.
MAIL_PROVIDER=resend
MAIL_FROM=Family Care <no-reply@your-domain>
RESEND_API_KEY=CHANGE_ME_resend_api_key

# (Tùy chọn) Brevo thay thế: MAIL_PROVIDER=brevo + BREVO_API_KEY=...
# BREVO_API_KEY=
# (Tùy chọn) SMTP thay thế: MAIL_PROVIDER=smtp + SMTP_*:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ====== Email verification OTP ======
EMAIL_VERIFICATION_OTP_EXPIRES_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# ====== Stripe (subscription payments) ======
STRIPE_SECRET_KEY=CHANGE_ME_stripe_secret_key
STRIPE_WEBHOOK_SECRET=CHANGE_ME_stripe_webhook_secret
STRIPE_CHECKOUT_SUCCESS_URL=https://your-frontend/subscription/success
STRIPE_CHECKOUT_CANCEL_URL=https://your-frontend/subscription/cancel
# Stripe recurring (annual) Price id cho gói trả phí (dùng cho `npm run seed`).
STRIPE_PRICE_PLUS=CHANGE_ME_price_plus
STRIPE_PRICE_PREMIUM=CHANGE_ME_price_premium

# ====== Rate limit (throttler) ======
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ====== Redis (BullMQ queue cho notifications realtime) ======
REDIS_HOST=redis
REDIS_PORT=6379

# ====== Firebase Cloud Messaging — base64 của file service-account JSON. ======
# Để trống = tắt kênh FCM (app vẫn chạy bình thường).
FIREBASE_SERVICE_ACCOUNT=

# ====== Admin Docker infrastructure ======
# Requires mounting /var/run/docker.sock into the API container.
# Set ADMIN_DOCKER_ENABLED=false if prod should not expose Docker monitoring;
# FE should hide the Docker section when dockerAvailable=false.
ADMIN_DOCKER_ENABLED=true
DOCKER_SOCKET_PATH=/var/run/docker.sock

# ====== Cloudflare R2 private storage ======
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=familycare
R2_PUBLIC_URL=https://legacy-chat-public-domain.example
R2_SIGNED_URL_TTL_SECONDS=600

# ====== Album moderation Phase 2 ======
CLOUDFLARE_ACCOUNT_ID=CHANGE_ME
CLOUDFLARE_API_TOKEN=CHANGE_ME_workers_ai_token
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
CLOUDFLARE_AI_TIMEOUT_MS=30000
CLOUDFLARE_QUEUE_ID=CHANGE_ME
CLOUDFLARE_QUEUE_API_TOKEN=CHANGE_ME_queue_token
ALBUM_MODERATION_CONSUMER_ENABLED=true
ALBUM_MODERATION_RECOVERY_ENABLED=true
ALBUM_MODERATION_RECOVERY_BATCH_SIZE=20
ALBUM_MODERATION_POLL_INTERVAL_MS=5000
ALBUM_MODERATION_BATCH_SIZE=1
ALBUM_MODERATION_VISIBILITY_TIMEOUT_MS=180000
ALBUM_MODERATION_MAX_ATTEMPTS=3
ALBUM_MODERATION_RETRY_DELAY_SECONDS=60
ALBUM_MODERATION_STALE_PROCESSING_MINUTES=10
ALBUM_MODERATION_REVIEW_THRESHOLD=0.45
ALBUM_MODERATION_FLAG_THRESHOLD=0.80
ALBUM_CLEANUP_ENABLED=true
ALBUM_CLEANUP_BATCH_SIZE=10
ALBUM_CLEANUP_MAX_ATTEMPTS=5
ALBUM_CLEANUP_RETRY_DELAY_SECONDS=60
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
ALBUM_VIDEO_FRAME_INTERVAL_SECONDS=5
ALBUM_VIDEO_MAX_FRAMES=12
ALBUM_VIDEO_FRAME_CONCURRENCY=1

# ====== Album face profile enrollment Phase 5 ======
FACE_AI_BASE_URL=http://face-ai-service:8000
FACE_AI_TIMEOUT_MS=30000
FACE_EMBEDDING_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
FACE_AI_MODEL_NAME=buffalo_l
FACE_AI_DETECTION_SIZE=640
FACE_AI_DEVICE=cpu

# ====== Album face scan suggestions Phase 6 ======
FACE_SCAN_MAX_FACES=5
FACE_MATCH_MIN_SIMILARITY=0.55
FACE_MATCH_MIN_MARGIN=0.08
FACE_SCAN_MAX_ATTEMPTS=3
FACE_SCAN_STALE_MINUTES=10
FACE_SCAN_CONSUMER_ENABLED=false

# ====== OpenAI (AI chatbot — trợ lý gia đình) ======
# Rỗng = tắt trợ lý AI (endpoint trả 503).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOOL_ROUNDS=5
OPENAI_TIMEOUT_MS=30000
AI_CHAT_MAX_HISTORY_MESSAGES=20
AI_ACTION_EXPIRES_MINUTES=15
