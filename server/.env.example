# ====== App ======
APP_NAME=Family Care API
APP_ENV=development
APP_PORT=3000
APP_PREFIX=api/v1

# ====== Database (PostgreSQL) ======
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456789
POSTGRES_DB=family_care_dev

# Prisma connection string. Must match the DB_* values above.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local (BE chạy ngoài Docker): host = localhost.
# Nếu chạy BE TRONG Docker, host phải là `db` (tên service compose) — xem .env.production.example.
DATABASE_URL="postgresql://postgres:123456789@postgres:5432/family_care_dev?schema=public"

# ====== JWT ======
# Generate strong random values, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ====== Security ======
BCRYPT_SALT_ROUNDS=10

# ====== Family invitations ======
INVITATION_EXPIRES_IN_DAYS=7

# ====== Email (xác thực tài khoản) ======
# Kênh gửi mail. Để trống = tự dò: RESEND_API_KEY → Resend; BREVO_API_KEY → Brevo;
# SMTP_HOST → SMTP; không có gì → in mã OTP ra console (tiện test dev).
# Ép kênh: 'resend' | 'brevo' | 'smtp'.
MAIL_PROVIDER=
# Chưa có domain riêng: để onboarding@resend.dev (Resend chỉ cho gửi tới email đã
# đăng ký tài khoản Resend). Có domain → đổi thành no-reply@your-domain (đã verify).
MAIL_FROM=Family Care <onboarding@resend.dev>

# --- Resend HTTP API (cổng 443) — KHUYẾN NGHỊ cho server/VPS chặn cổng SMTP ---
# Lấy key: https://resend.com → API Keys.
RESEND_API_KEY=

# --- Brevo HTTP API (cổng 443) — lựa chọn thay thế ---
BREVO_API_KEY=

# --- SMTP (nodemailer) — tiện cho dev local (Gmail App Password / Mailtrap) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ====== Email verification OTP ======
EMAIL_VERIFICATION_OTP_EXPIRES_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# ====== Admin seed (npm run seed) ======
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@Admin1

# ====== Misc ======
SWAGGER_ENABLED=true

# ====== Stripe (subscription payments — test mode) ======
# Lấy từ Stripe Dashboard (test mode). Webhook secret từ `stripe listen` hoặc endpoint.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/subscription/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/subscription/cancel
# Stripe recurring (annual) Price id cho gói trả phí. Đặt 2 biến này rồi `npm run seed`
# để tự gắn vào DB (cùng 1 account Stripe test → chia sẻ chung price id cho cả team).
STRIPE_PRICE_PLUS=price_xxx
STRIPE_PRICE_PREMIUM=price_yyy

# ====== Third-party (fill when needed) ======
FCM_SERVER_KEY=
OPENAI_API_KEY=
STORAGE_BUCKET=