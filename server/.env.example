# ====== App ======
APP_NAME=Family Care API
APP_ENV=development
APP_PORT=3000
APP_PREFIX=api/v1

# ====== Database (PostgreSQL) ======
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456789
POSTGRES_DB=family_care_dev

# Prisma connection string. Must match the DB_* values above.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local (BE chạy ngoài Docker): host = localhost.
# Nếu chạy BE TRONG Docker, host phải là `db` (tên service compose) — xem .env.production.example.
DATABASE_URL="postgresql://postgres:123456789@postgres:5432/family_care_dev?schema=public"

# ====== JWT ======
# Generate strong random values, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ====== Security ======
BCRYPT_SALT_ROUNDS=10

# ====== Family invitations ======
INVITATION_EXPIRES_IN_DAYS=7

# ====== Misc ======
SWAGGER_ENABLED=true

# ====== Third-party (fill when needed) ======
FCM_SERVER_KEY=
OPENAI_API_KEY=
PAYMENT_SECRET_KEY=
STORAGE_BUCKET=