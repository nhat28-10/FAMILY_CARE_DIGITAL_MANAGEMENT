APP_NAME=Family Care API
APP_ENV=development
APP_PORT=3000
APP_PREFIX=api/v1

# Local Node.js run: DB_HOST=localhost
# Docker Compose run: docker-compose.yml overrides this to DB_HOST=postgres
# Kubernetes demo: server-configmap.yaml uses DB_HOST=family-care-postgres

# DB_HOST=localhost            dùng khi chạy NestJS trực tiếp ngoài Docker
# DB_HOST=postgres             dùng khi chạy bằng Docker Compose
# DB_HOST=family-care-postgres dùng khi chạy Kubernetes local
DB_HOST=localhost 
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=family_care_dev

# PostgreSQL container variables. Keep these values equal to DB_* above for Docker Compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=family_care_dev

JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

SWAGGER_ENABLED=true

# Comma-separated origins. Use * only for quick local/demo, not real production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081,http://localhost:19006

FCM_SERVER_KEY=
OPENAI_API_KEY=
PAYMENT_SECRET_KEY=
STORAGE_BUCKET=