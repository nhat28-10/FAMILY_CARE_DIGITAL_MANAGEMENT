# ====== App ======
APP_NAME=Family Care API
APP_ENV=development
APP_PORT=3000
APP_PREFIX=api/v1

# ====== Database (PostgreSQL) ======
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456789
POSTGRES_DB=family_care_dev

# Prisma connection string. Must match the DB_* values above.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local (BE chạy ngoài Docker): host = localhost.
# Nếu chạy BE TRONG Docker, host phải là `db` (tên service compose) — xem .env.production.example.
DATABASE_URL="postgresql://postgres:123456789@postgres:5432/family_care_dev?schema=public"

# ====== JWT ======
# Generate strong random values, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ====== Security ======
BCRYPT_SALT_ROUNDS=10

# ====== Email (xác thực tài khoản) ======
# Kênh gửi mail. Để trống = tự dò: RESEND_API_KEY → Resend; BREVO_API_KEY → Brevo;
# SMTP_HOST → SMTP; không có gì → in mã OTP ra console (tiện test dev).
# Ép kênh: 'resend' | 'brevo' | 'smtp'.
MAIL_PROVIDER=
# Chưa có domain riêng: để onboarding@resend.dev (Resend chỉ cho gửi tới email đã
# đăng ký tài khoản Resend). Có domain → đổi thành no-reply@your-domain (đã verify).
MAIL_FROM=Family Care <onboarding@resend.dev>

# --- Resend HTTP API (cổng 443) — KHUYẾN NGHỊ cho server/VPS chặn cổng SMTP ---
# Lấy key: https://resend.com → API Keys.
RESEND_API_KEY=

# --- Brevo HTTP API (cổng 443) — lựa chọn thay thế ---
BREVO_API_KEY=

# --- SMTP (nodemailer) — tiện cho dev local (Gmail App Password / Mailtrap) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ====== Email verification OTP ======
EMAIL_VERIFICATION_OTP_EXPIRES_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# ====== Password reset OTP ======
PASSWORD_RESET_OTP_EXPIRES_MINUTES=10
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5

# ====== Admin seed (npm run seed) ======
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@Admin1

# ====== Misc ======
SWAGGER_ENABLED=true

# ====== Admin Docker infrastructure ======
# Set ADMIN_DOCKER_ENABLED=false if production does not mount Docker socket; FE
# should hide the Docker section when dockerAvailable=false.
ADMIN_DOCKER_ENABLED=true
DOCKER_SOCKET_PATH=/var/run/docker.sock

# ====== Stripe (subscription payments — test mode) ======
# Lấy từ Stripe Dashboard (test mode). Webhook secret từ `stripe listen` hoặc endpoint.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/subscription/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/subscription/cancel
# Stripe recurring (annual) Price id cho gói trả phí. Đặt 2 biến này rồi `npm run seed`
# để tự gắn vào DB (cùng 1 account Stripe test → chia sẻ chung price id cho cả team).
STRIPE_PRICE_PLUS=price_xxx
STRIPE_PRICE_PREMIUM=price_yyy

# ====== Rate limit (throttler) ======
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ====== Redis (BullMQ queue cho notifications realtime) ======
REDIS_HOST=localhost
REDIS_PORT=6379

# ====== Firebase — base64 của file service-account JSON. ======
# Dùng chung cho CẢ HAI: đăng nhập Google (POST /auth/firebase) và push FCM.
# Đây là biến DUY NHẤT bật/tắt push — không có FCM_SERVER_KEY (API legacy, đã bỏ).
# Để trống = tắt kênh FCM, chỉ còn WS (app vẫn chạy bình thường).
FIREBASE_SERVICE_ACCOUNT=

# ====== Cloudflare R2 (lưu ảnh/file chat + album — S3-compatible) ======
# Tạo bucket + API token tại Cloudflare Dashboard → R2. Bật Public access cho bucket
# (hoặc gắn custom domain) rồi điền URL public vào R2_PUBLIC_URL.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=familycare
R2_PUBLIC_URL=https://pub-xxx.r2.dev
# Thời gian hiệu lực mặc định của signed GET URL cho media private (giây).
R2_SIGNED_URL_TTL_SECONDS=600

# ====== OpenAI (AI chatbot — trợ lý gia đình) ======
# Rỗng = tắt trợ lý AI (endpoint trả 503). Lấy key tại https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOOL_ROUNDS=5
OPENAI_TIMEOUT_MS=30000
AI_CHAT_MAX_HISTORY_MESSAGES=20
AI_ACTION_EXPIRES_MINUTES=15

# ====== Third-party (fill when needed) ======
STORAGE_BUCKET=

# ====== Album moderation Phase 2 (Cloudflare Queues + Workers AI) ======
# Account ID is an identifier; keep API tokens secret and never commit real values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
CLOUDFLARE_AI_TIMEOUT_MS=30000
CLOUDFLARE_QUEUE_ID=
# May reuse CLOUDFLARE_API_TOKEN, but a dedicated token with Queues Read/Write is recommended.
CLOUDFLARE_QUEUE_API_TOKEN=
ALBUM_MODERATION_CONSUMER_ENABLED=false
ALBUM_MODERATION_RECOVERY_ENABLED=true
ALBUM_MODERATION_RECOVERY_BATCH_SIZE=20
ALBUM_MODERATION_POLL_INTERVAL_MS=5000
ALBUM_MODERATION_BATCH_SIZE=2
ALBUM_MODERATION_VISIBILITY_TIMEOUT_MS=180000
ALBUM_MODERATION_MAX_ATTEMPTS=3
ALBUM_MODERATION_RETRY_DELAY_SECONDS=60
ALBUM_MODERATION_STALE_PROCESSING_MINUTES=10
ALBUM_MODERATION_REVIEW_THRESHOLD=0.45
ALBUM_MODERATION_FLAG_THRESHOLD=0.80
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
ALBUM_VIDEO_FRAME_INTERVAL_SECONDS=5
ALBUM_VIDEO_MAX_FRAMES=12
ALBUM_VIDEO_FRAME_CONCURRENCY=1

# ====== Album R2 cleanup/reconciliation Phase 4 ======
ALBUM_CLEANUP_ENABLED=true
ALBUM_CLEANUP_BATCH_SIZE=10
ALBUM_CLEANUP_MAX_ATTEMPTS=5
ALBUM_CLEANUP_RETRY_DELAY_SECONDS=60

# ====== Album face profile enrollment Phase 5 ======
FACE_AI_BASE_URL=http://face-ai-service:8000
FACE_AI_TIMEOUT_MS=30000
# Base64 of exactly 32 bytes. Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FACE_EMBEDDING_ENCRYPTION_KEY=
FACE_AI_MODEL_NAME=buffalo_l
FACE_AI_DETECTION_SIZE=640
FACE_AI_DEVICE=cpu

# ====== Album face scan suggestions Phase 6 ======
FACE_SCAN_MAX_FACES=5
FACE_MATCH_MIN_SIMILARITY=0.55
FACE_MATCH_MIN_MARGIN=0.08
FACE_SCAN_MAX_ATTEMPTS=3
FACE_SCAN_STALE_MINUTES=10
FACE_SCAN_CONSUMER_ENABLED=true
