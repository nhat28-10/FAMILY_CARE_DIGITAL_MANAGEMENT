//// ------------------------------------------------------
//// LOGICAL ERD — auto-generated từ Prisma schema. Chỉ hiện tên thuộc tính +
//// đánh dấu PK/FK, KHÔNG hiện kiểu dữ liệu vật lý.
//// Cách xem: mở https://dbdiagram.io -> Import -> DBML (hoặc paste nội dung file này).
//// Chạy lại: node scripts/gen-logical-erd-dbml.js
//// ------------------------------------------------------

Project "Family Care - Logical ERD" {
  Note: 'Mo hinh du lieu muc nghiep vu - chi hien thuoc tinh + PK/FK, khong hien kieu du lieu vat ly.'
}

