Ref: WorkspaceProvisioningLog."Created By User ID" > User."Id"
Ref: FamilySubscription."Purchased By User ID" > User."Id"
Ref: WearableActivationSession."Claimed Refresh Token ID" > RefreshToken."Id"
Ref: FamilyMember."Family ID" > Family."Id"
Ref: JoinRequest."Family ID" > Family."Id"
Ref: FinanceLedger."Family ID" > Family."Id"
