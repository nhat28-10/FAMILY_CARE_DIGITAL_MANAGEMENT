}

model GoalAllocation {
  id                  String   @id @default(uuid())
  goalId              String
  ledgerEntryId       String
  amount              Decimal  @db.Decimal(18, 2)
  allocatedByMemberId String
  allocatedAt         DateTime @default(now())

