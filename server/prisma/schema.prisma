  financeLedgerId String?

  @@index([familyId])
  @@index([sourceKey])
  @@index([budgetPlanId])
  @@index([goalId])
  @@index([jarId])
  @@index([categoryId])
  @@index([alertType])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
