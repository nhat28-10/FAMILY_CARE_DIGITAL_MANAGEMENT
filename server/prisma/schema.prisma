// Prisma schema for Family Finance Management Platform
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider            = "prisma-dbml-generator"
  output              = "./dbml"
  outputName          = "family-care.dbml"
  projectName         = "Family Care Digital Management"
  projectDatabaseType = "PostgreSQL"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Enums — 3-layer role model
// ===========================================================================

/// Account-level user type (ERD: user_type). System-wide; family roles live on FamilyMember.familyRole, not here.
enum UserType {
  NORMAL_USER
  SYSTEM_ADMIN
}

/// Account lifecycle status (ERD: account_status).
enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Role of a user inside a specific family (ERD: family_role).
enum FamilyRole {
  FAMILY_MANAGER
  DEPUTY_MEMBER
  FAMILY_MEMBER
}

/// Family relationship — display only (ERD: relationship_type).
enum Relationship {
  FATHER
  MOTHER
  SPOUSE
  CHILD
  SISTER
  BROTHER
  GRANDPARENT
  OTHER
}

/// Email/phone verification status of a user account (ERD: verification_status).
enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

/// Operational lifecycle of a family workspace (ERD: workspace_status).
enum WorkspaceStatus {
  ACTIVE
  PENDING
  SUSPENDED
  EXPIRED
}

/// Provisioning/activation result of a family workspace (ERD: activation_status).
enum ActivationStatus {
  ACTIVE
  PENDING
  FAILED
}

/// Membership lifecycle of a family member (ERD: member_status).
enum MemberStatus {
  ACTIVE
  INACTIVE
  REMOVED
}

/// Controls whether a member's monthly finance summary is private or visible within their family workspace.
enum FinanceVisibility {
  PRIVATE
  FAMILY
}

/// Lifecycle status of the single shared finance ledger owned by a family.
enum FinanceLedgerStatus {
  ACTIVE
  INACTIVE
}

/// Whether a finance category records incoming or outgoing money.
enum FinanceCategoryType {
  INCOME
  EXPENSE
}

/// Essential classification used for family expense analysis.
enum EssentialType {
  ESSENTIAL
  NON_ESSENTIAL
  NEUTRAL
}

/// Lifecycle status of a family-defined finance category.
enum FinanceCategoryStatus {
  ACTIVE
  INACTIVE
}

/// Business classification of a shared family ledger entry.
enum LedgerEntryType {
  INCOME
  EXPENSE
  CONTRIBUTION
  ALLOWANCE
  REWARD
  SUPPORT
  ADJUSTMENT
}

/// Ledger entries are retained for traceability and voided instead of deleted.
enum LedgerEntryStatus {
  ACTIVE
  VOIDED
}

/// Allocation strategy used by a family for its internal finance planning.
enum FinanceModelType {
  FIVE_JARS
  EIGHTY_TWENTY
  CUSTOM
}

/// Lifecycle of a family's finance allocation configuration.
enum FinanceModelStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum BudgetPeriodType {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BudgetPlanStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELED
}

enum FinancialGoalStatus {
  ACTIVE
  ACHIEVED
  CANCELED
  AT_RISK
}

enum GoalContributionPlanStatus {
  PLANNED
  PENDING_CONFIRMATION
  PARTIAL
  PAID
  MISSED
  REJECTED
}

enum BudgetAlertType {
  OVER_BUDGET
  GOAL_AT_RISK
  NON_ESSENTIAL_TOO_HIGH
}

enum BudgetAlertSeverity {
  LOW
  MEDIUM
  HIGH
}

enum BudgetAlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
}

enum SpendingSupportRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum TaskCategoryStatus {
  ACTIVE
  INACTIVE
}

enum TaskType {
  AD_HOC
  RECURRING
}

enum TaskRepeatType {
  DAILY
  WEEKLY
  MONTHLY
}

enum TaskScheduleStatus {
  ACTIVE
  INACTIVE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELED
}

enum TaskAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  CANCELED
}

enum TaskSubmissionStatus {
  WAITING_REVIEW
  APPROVED
  REJECTED
}

enum TaskUnavailabilityStatus {
  REPORTED
  HANDLED
  CANCELED
}

enum RewardType {
  MONEY_RECORD
  POINT
  OTHER
}

enum RewardSettlementStatus {
  PENDING_SETTLEMENT
  WAITING_CONFIRMATION
  SETTLED
  DISPUTED
  CANCELED
}

enum RewardDisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum RewardExternalMethod {
  CASH
  BANK_TRANSFER
  THIRD_PARTY_WALLET
  OTHER
}

enum TaskProofType {
  IMAGE
  VIDEO
  NOTE
  FILE
}

// ===========================================================================
// Models
// ===========================================================================

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String?
  /// Firebase Auth UID — set khi user đăng nhập Google (social login). Null = chưa liên kết.
  firebaseUid        String?            @unique
  fullName           String?
  /// ERD: phone_number — optional, unique when present.
  phone              String?            @unique
  /// ERD: avatar_url.
  avatarUrl          String?
  /// ERD: user_type — NORMAL_USER vs SYSTEM_ADMIN (not a family role).
  userType           UserType           @default(NORMAL_USER)
  /// ERD: account_status.
  accountStatus      AccountStatus      @default(ACTIVE)
  /// ERD: verification_status.
  verificationStatus VerificationStatus @default(UNVERIFIED)
  /// ERD: last_login_at — set on each successful login.
  lastLoginAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  memberships             FamilyMember[]
  refreshTokens           RefreshToken[]
  deviceTokens            DeviceToken[]
  ownedWearableDevices    WearableDevice[]            @relation("OwnedUserWearableDevices")
  wearableActivations     WearableActivationSession[] @relation("WearableActivationOwnerUser")
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  joinRequests            JoinRequest[]
  provisioningLogs        WorkspaceProvisioningLog[]  @relation("CreatedProvisioningLogs")
  purchasedSubscriptions  FamilySubscription[]        @relation("PurchasedSubscriptions")

  @@map("users")
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  adminUserId  String
  adminEmail   String?
  adminName    String?
  action       String
  targetType   String
  targetId     String?
  result       String
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([targetType])
  @@index([targetId])
  @@index([result])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

/// Mã OTP xác thực email (6 số). Chỉ lưu sha256 của mã, không lưu mã thật. `usedAt` đánh dấu đã dùng; `attempts` đếm số lần nhập sai để khóa tạm.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Mã OTP đặt lại mật khẩu (6 số). Chỉ lưu sha256 của mã, không lưu mã thật. `usedAt` đánh dấu đã dùng/vô hiệu; `attempts` đếm số lần nhập sai để khóa tạm.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// One row per active refresh token (per device/session). The raw token is never stored — only its bcrypt hash. Supports multi-device + per-session revocation and rotation.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  wearableActivationSessions WearableActivationSession[] @relation("WearableActivationClaimedRefreshToken")

  @@index([userId])
  @@map("refresh_tokens")
}

model Family {
  id               String           @id @default(uuid())
  name             String
  /// ERD: description.
  description      String?
  /// ERD: avatar_url.
  avatarUrl        String?
  /// ERD: workspace_status.
  status           WorkspaceStatus  @default(ACTIVE)
  /// ERD: activation_status.
  activationStatus ActivationStatus @default(ACTIVE)
  /// Mã mời ngắn của gia đình (kiểu Zalo). Null = manager chưa tạo mã.
  inviteCode       String?          @unique @map("invite_code")
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  members                    FamilyMember[]
  joinRequests               JoinRequest[]
  financeLedger              FinanceLedger?
  financeCategories          FinanceCategory[]
  financeModels              FinanceModel[]
  financeCategoryJarMappings FinanceCategoryJarMapping[]
  budgetPlans                BudgetPlan[]
  financialGoals             FinancialGoal[]
  goalContributionPlans      GoalContributionPlan[]
  budgetAlerts               BudgetAlert[]
  spendingSupportRequests    SpendingSupportRequest[]
  taskCategories             TaskCategory[]
  tasks                      Task[]
  sosSetting                 SosSetting?
  wearableDevices            WearableDevice[]
  wearableActivations        WearableActivationSession[]
  sosAlerts                  SosAlert[]
  memberLocationPoints       MemberLocationPoint[]
  notifications              Notification[]
  subscription               FamilySubscription?
  paymentTransactions        PaymentTransaction[]
  provisioningLogs           WorkspaceProvisioningLog[]
  conversations              Conversation[]
  familyAnnouncements        FamilyAnnouncement[]
  calendarEvents             CalendarEvent[]
  albumCollections           AlbumCollection[]
  albumMedia                 AlbumMedia[]
  storageCleanupJobs         StorageCleanupJob[]
  memberFaceProfiles         MemberFaceProfile[]
  faceScanJobs               FaceScanJob[]
  albumFaceDetections        AlbumFaceDetection[]
  albumTagSuggestions        AlbumTagSuggestion[]
  aiConversations            AIConversation[]

  @@map("families")
}

model FamilyMember {
  id                     String       @id @default(uuid())
  familyId               String
  userId                 String
  /// ERD: display_name — per-family display name override.
  displayName            String?
  familyRole             FamilyRole   @default(FAMILY_MEMBER)
  relationship           Relationship @default(OTHER)
  /// ERD: member_status.
  status                 MemberStatus @default(ACTIVE)
  /// Opt-in daily location sharing on the family map (separate from SOS tracking).
  locationSharingEnabled Boolean      @default(false) @map("location_sharing_enabled")
  joinedAt               DateTime     @default(now())
  /// ERD: left_at — set when the member leaves/is removed.
  leftAt                 DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @default(now()) @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  decidedJoinRequests              JoinRequest[]               @relation("DecidedJoinRequests")
  monthlyFinances                  MemberMonthlyFinance[]
  createdLedgerEntries             LedgerEntry[]               @relation("CreatedLedgerEntries")
  createdBudgetPlans               BudgetPlan[]                @relation("CreatedBudgetPlans")
  createdFinancialGoals            FinancialGoal[]             @relation("CreatedFinancialGoals")
  goalAllocations                  GoalAllocation[]            @relation("GoalAllocations")
  requestedSpendingSupportRequests SpendingSupportRequest[]    @relation("RequestedSpendingSupportRequests")
  reviewedSpendingSupportRequests  SpendingSupportRequest[]    @relation("ReviewedSpendingSupportRequests")
  createdTasks                     Task[]                      @relation("CreatedTasks")
  assignedTasks                    TaskAssignment[]            @relation("TaskAssignedTo")
  givenTaskAssignments             TaskAssignment[]            @relation("TaskAssignedBy")
  submittedTaskSubmissions         TaskSubmission[]            @relation("TaskSubmissionSubmittedBy")
  reviewedTaskSubmissions          TaskSubmission[]            @relation("TaskSubmissionReviewedBy")
  reportedTaskUnavailabilities     TaskUnavailability[]        @relation("TaskUnavailabilityReportedBy")
  handledTaskUnavailabilities      TaskUnavailability[]        @relation("TaskUnavailabilityHandledBy")
  receivedRewardSettlements        RewardSettlement[]          @relation("RewardSettlementReceiver")
  settledRewardSettlements         RewardSettlement[]          @relation("RewardSettlementSettledBy")
  rewardAllocations                RewardAllocation[]          @relation("RewardAllocationAllocatedBy")
  reportedRewardDisputes           RewardDispute[]             @relation("RewardDisputeReportedBy")
  resolvedRewardDisputes           RewardDispute[]             @relation("RewardDisputeResolvedBy")
  createdSosSettings               SosSetting[]                @relation("CreatedSosSettings")
  ownedWearableDevices             WearableDevice[]            @relation("OwnedWearableDevices")
  wearableActivations              WearableActivationSession[] @relation("WearableActivationOwnerMember")
  triggeredSosAlerts               SosAlert[]                  @relation("TriggeredSosAlerts")
  resolvedSosAlerts                SosAlert[]                  @relation("ResolvedSosAlerts")
  sosResponses                     SosResponse[]               @relation("SosResponses")
  memberLocationPoints             MemberLocationPoint[]       @relation("MemberLocationPoints")
  notifications                    Notification[]              @relation("MemberNotifications")
  createdConversations             Conversation[]              @relation("CreatedConversations")
  conversationParticipations       ConversationParticipant[]   @relation("ConversationParticipations")
  sentMessages                     Message[]                   @relation("SentMessages")
  pinnedMessages                   Message[]                   @relation("PinnedMessages")
  messageReactions                 MessageReaction[]           @relation("MessageReactions")
  initiatedCalls                   Call[]                      @relation("InitiatedCalls")
  callParticipations               CallParticipant[]           @relation("CallParticipations")
  createdAnnouncements             FamilyAnnouncement[]        @relation("CreatedAnnouncements")
  createdCalendarEvents            CalendarEvent[]             @relation("CreatedCalendarEvents")
  calendarEventParticipations      CalendarEventParticipant[]  @relation("CalendarEventParticipations")
  createdAlbumCollections          AlbumCollection[]           @relation("CreatedAlbumCollections")
  uploadedAlbumMedia               AlbumMedia[]                @relation("UploadedAlbumMedia")
  deletedAlbumMedia                AlbumMedia[]                @relation("DeletedAlbumMedia")
  reviewedModerationChecks         MediaModerationCheck[]      @relation("ReviewedModerationChecks")
  taggedAlbumMediaTags             AlbumMediaTag[]             @relation("TaggedAlbumMediaTags")
  createdAlbumMediaTags            AlbumMediaTag[]             @relation("CreatedAlbumMediaTags")
  faceProfiles                     MemberFaceProfile[]         @relation("MemberFaceProfiles")
  consentedFaceProfiles            MemberFaceProfile[]         @relation("ConsentedFaceProfiles")
  requestedFaceScanJobs            FaceScanJob[]               @relation("RequestedFaceScanJobs")
  suggestedAlbumTagSuggestions     AlbumTagSuggestion[]        @relation("SuggestedAlbumTagSuggestions")
  confirmedAlbumTagSuggestions     AlbumTagSuggestion[]        @relation("ConfirmedAlbumTagSuggestions")
  rejectedAlbumTagSuggestions      AlbumTagSuggestion[]        @relation("RejectedAlbumTagSuggestions")
  aiConversations                  AIConversation[]            @relation("MemberAIConversations")
  goalContributionPlans            GoalContributionPlan[]      @relation("GoalContributionPlans")
  reviewedGoalContributionPlans    GoalContributionPlan[]      @relation("ReviewedGoalContributionPlans")

  @@unique([familyId, userId])
  @@index([userId])
  @@map("family_members")
}

/// Trạng thái yêu cầu tham gia gia đình bằng mã mời.
enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

/// Yêu cầu tham gia gia đình: user nhập mã mời của family và chờ manager duyệt.
model JoinRequest {
  id                String            @id @default(uuid())
  familyId          String
  userId            String
  status            JoinRequestStatus @default(PENDING)
  /// Lời nhắn của người xin vào (vd "Con là út của bố").
  message           String?
  /// Thành viên (manager) đã duyệt/từ chối yêu cầu.
  decidedByMemberId String?
  decidedAt         DateTime?
  createdAt         DateTime          @default(now())

  family          Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedByMember FamilyMember? @relation("DecidedJoinRequests", fields: [decidedByMemberId], references: [id], onDelete: SetNull)

  @@index([familyId, status])
  @@index([userId])
  @@map("join_requests")
}

/// Monthly personal income and expense summary for a family member. This is a summary only; personal ledger entries are intentionally not modeled.
model MemberMonthlyFinance {
  id                         String            @id @default(uuid())
  memberId                   String
  periodMonth                Int
  periodYear                 Int
  expectedIncome             Decimal?          @db.Decimal(18, 2)
  actualIncome               Decimal?          @db.Decimal(18, 2)
  expectedPersonalExpense    Decimal?          @db.Decimal(18, 2)
  actualPersonalExpense      Decimal?          @db.Decimal(18, 2)
  expectedSharedContribution Decimal?          @db.Decimal(18, 2)
  actualSharedContribution   Decimal?          @db.Decimal(18, 2)
  incomeVisibility           FinanceVisibility @default(PRIVATE)
  expenseVisibility          FinanceVisibility @default(PRIVATE)
  note                       String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, periodMonth, periodYear])
  @@index([periodYear, periodMonth])
  @@map("member_monthly_finances")
}

/// The single shared finance ledger for a family workspace. Family finance is an internal record system and does not represent a real-money wallet.
model FinanceLedger {
  id         String              @id @default(uuid())
  familyId   String              @unique
  ledgerName String
  status     FinanceLedgerStatus @default(ACTIVE)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  entries      LedgerEntry[]
  budgetLines  BudgetLine[]
  budgetAlerts BudgetAlert[]

  @@map("finance_ledgers")
}

/// Family-defined classification for shared ledger entries.
model FinanceCategory {
  id            String                @id @default(uuid())
  familyId      String
  name          String
  categoryType  FinanceCategoryType
  essentialType EssentialType         @default(NEUTRAL)
  status        FinanceCategoryStatus @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  family                  Family                      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  entries                 LedgerEntry[]
  budgetLines             BudgetLine[]
  budgetAlerts            BudgetAlert[]
  jarMappings             FinanceCategoryJarMapping[]
  spendingSupportRequests SpendingSupportRequest[]

  @@unique([familyId, name, categoryType])
  @@index([familyId, categoryType, status])
  @@map("finance_categories")
}

/// Historical finance allocation configuration for a family. Only one model may be active for a family at a time.
model FinanceModel {
  id        String             @id @default(uuid())
  familyId  String
  modelType FinanceModelType
  name      String
  status    FinanceModelStatus @default(DRAFT)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  family              Family                      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  jars                FinanceJar[]
  categoryJarMappings FinanceCategoryJarMapping[]

  @@index([familyId, status])
  @@map("finance_models")
}

/// Jar/fund allocation belonging to one finance model. Percentages are planning values only and never represent stored real money.
model FinanceJar {
  id                   String   @id @default(uuid())
  financeModelId       String
  name                 String
  jarCode              String
  allocationPercentage Decimal  @db.Decimal(5, 2)
  description          String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  financeModel      FinanceModel                @relation(fields: [financeModelId], references: [id], onDelete: Cascade)
  budgetLines       BudgetLine[]
  financialGoals    FinancialGoal[]
  ledgerEntries     LedgerEntry[]
  budgetAlerts      BudgetAlert[]
  rewardAllocations RewardAllocation[]
  categoryMappings  FinanceCategoryJarMapping[]

  @@unique([financeModelId, jarCode])
  @@index([financeModelId, isActive])
  @@map("finance_jars")
}

/// Default jar assignment for a category inside one finance model.
/// The same category can point to different jars in FIVE_JARS vs EIGHTY_TWENTY.
model FinanceCategoryJarMapping {
  id             String   @id @default(uuid())
  familyId       String
  financeModelId String
  categoryId     String
  jarId          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  family       Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  financeModel FinanceModel    @relation(fields: [financeModelId], references: [id], onDelete: Cascade)
  category     FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  jar          FinanceJar      @relation(fields: [jarId], references: [id], onDelete: Cascade)

  @@unique([financeModelId, categoryId])
  @@index([familyId])
  @@index([financeModelId])
  @@index([categoryId])
  @@index([jarId])
  @@map("finance_category_jar_mappings")
}

/// Immutable-style record in the shared family ledger. Corrections should be represented by voiding or adjustment entries rather than deleting history.
model LedgerEntry {
  id                String            @id @default(uuid())
  ledgerId          String
  categoryId        String?
  jarId             String?
  createdByMemberId String
  entryType         LedgerEntryType
  amount            Decimal           @db.Decimal(18, 2)
  description       String
  note              String?
  entryDate         DateTime
  status            LedgerEntryStatus @default(ACTIVE)
  sourceType        String?
  sourceId          String?
  metadata          Json?             @db.JsonB
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  ledger            FinanceLedger      @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  category          FinanceCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  jar               FinanceJar?        @relation(fields: [jarId], references: [id], onDelete: SetNull)
  createdByMember   FamilyMember       @relation("CreatedLedgerEntries", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  goalAllocations   GoalAllocation[]
  rewardAllocations RewardAllocation[]

  @@index([ledgerId, entryDate])
  @@index([ledgerId, entryType, status])
  @@index([categoryId])
  @@index([jarId])
  @@index([createdByMemberId])
  @@index([sourceType, sourceId])
  @@map("ledger_entries")
}

/// Subscription plan tier (ERD: SubscriptionPlan). Paid plans are annual-only; admins (SYSTEM_ADMIN) manage these, family workspaces subscribe to them.
model SubscriptionPlan {
  id            String        @id @default(uuid())
  /// Unique plan code, e.g. FREE / PLUS / PREMIUM / GOLD. `FREE` is reserved as the default plan for new families.
  planCode      String        @unique
  name          String
  /// ERD: annual_price — paid plans are billed yearly.
  annualPrice   Decimal       @db.Decimal(18, 2)
  /// Canonical billing cadence used by Admin and Stripe price creation.
  billingPeriod BillingPeriod @default(YEARLY)
  /// Monthly price for MONTHLY plans. Null for FREE/YEARLY unless configured for display.
  monthlyPrice  Decimal?      @db.Decimal(18, 2)
  /// Yearly price for YEARLY plans. Null for FREE/MONTHLY unless configured for display.
  yearlyPrice   Decimal?      @db.Decimal(18, 2)
  /// ERD: max_members — member cap enforced per workspace subscription.
  maxMembers    Int
  /// ERD: storage_limit — storage allowance in megabytes.
  storageLimit  Int
  /// ERD: feature_access — feature flags/limits map for the tier.
  featureAccess Json?
  /// Stripe recurring (annual) Price id — required for paid tiers (PLUS/PREMIUM).
  stripePriceId String?       @unique
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  familySubscriptions FamilySubscription[]

  @@map("subscription_plans")
}

/// Lifecycle state of a family's subscription (mirrors Stripe subscription status).
enum FamilySubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingPeriod {
  FREE
  MONTHLY
  YEARLY
}

/// One row per family (always present). New families start on FREE with no expiry; buying a paid plan moves the row to PLUS/PREMIUM and fills the Stripe ids. Webhooks are the source of truth for status/period changes.
model FamilySubscription {
  id                   String                   @id @default(uuid())
  familyId             String                   @unique
  planId               String
  status               FamilySubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?                  @unique
  /// null for FREE (no expiry); set from Stripe current_period_start for paid plans.
  currentPeriodStart   DateTime?
  /// null for FREE (no expiry); set from Stripe current_period_end for paid plans.
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean                  @default(false)
  /// User accountable for the current paid plan (who bought/renewed it). Null for FREE / auto-seeded rows. SetNull on user delete so billing history survives. Only a FAMILY_MANAGER can become the purchaser (enforced in the API).
  purchasedByUserId    String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
  purchasedBy User?            @relation("PurchasedSubscriptions", fields: [purchasedByUserId], references: [id], onDelete: SetNull)

  @@map("family_subscriptions")
}

/// Payment/webhook history. `stripeEventId` is unique so replayed Stripe webhook events are idempotent (duplicate inserts fail and are skipped).
model PaymentTransaction {
  id            String   @id @default(uuid())
  familyId      String
  stripeEventId String   @unique
  type          String
  amount        Decimal? @db.Decimal(18, 2)
  currency      String?
  status        String
  rawPayload    Json
  createdAt     DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("payment_transactions")
}

model SpendingSupportRequest {
  id                 String                       @id @default(uuid())
  familyId           String
  requesterMemberId  String
  amount             Decimal                      @db.Decimal(18, 2)
  categoryId         String?
  purpose            String
