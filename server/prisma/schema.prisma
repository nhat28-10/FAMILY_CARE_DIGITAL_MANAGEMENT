/// Family-level budget plan for an internal planning period.
model BudgetPlan {
  id                    String           @id @default(uuid())
  familyId              String
  planName              String
  periodType            BudgetPeriodType
  periodStart           DateTime         @db.Date
  periodEnd             DateTime         @db.Date
  expectedSharedIncome  Decimal?         @db.Decimal(18, 2)
  expectedSharedExpense Decimal?         @db.Decimal(18, 2)
  status                BudgetPlanStatus @default(DRAFT)
  createdByMemberId     String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  family          Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdByMember FamilyMember  @relation("CreatedBudgetPlans", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  lines           BudgetLine[]
  budgetAlerts    BudgetAlert[]

  @@index([familyId])
  @@index([periodStart, periodEnd])
  @@index([status])
  @@map("budget_plans")
