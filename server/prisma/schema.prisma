}

model TaskCategory {
  id          String             @id @default(uuid())
  familyId    String
  name        String
  description String?
  status      TaskCategoryStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@unique([familyId, name])
  @@index([familyId, status])
  @@map("task_categories")
}

model Task {
  id                String       @id @default(uuid())
  familyId          String
  taskCategoryId    String?
  title             String
  description       String?
  taskType          TaskType     @default(AD_HOC)
  priority          TaskPriority @default(MEDIUM)
  status            TaskStatus   @default(ACTIVE)
  createdByMemberId String
  dueAt             DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  family          Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category        TaskCategory?    @relation(fields: [taskCategoryId], references: [id], onDelete: SetNull)
  createdByMember FamilyMember     @relation("CreatedTasks", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  assignments     TaskAssignment[]
  schedule        TaskSchedule?
  rewardSetting   RewardSetting?

  @@index([familyId])
  @@index([taskCategoryId])
  @@index([createdByMemberId])
  @@index([status])
  @@index([dueAt])
  @@map("tasks")
}

model TaskSchedule {
  id             String             @id @default(uuid())
  taskId         String             @unique
  repeatType     TaskRepeatType
  repeatInterval Int
  startDate      DateTime           @db.Date
  endDate        DateTime?          @db.Date
  dayOfWeek      Int?
  status         TaskScheduleStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([status])
  @@index([startDate])
  @@map("task_schedules")
}

model TaskAssignment {
  id                 String               @id @default(uuid())
  taskId             String
  assignedToMemberId String
  assignedByMemberId String
  status             TaskAssignmentStatus @default(ASSIGNED)
  assignedAt         DateTime             @default(now())
  startAt            DateTime?
  dueAt              DateTime?
  reminderSentAt     DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  task             Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignedToMember FamilyMember         @relation("TaskAssignedTo", fields: [assignedToMemberId], references: [id], onDelete: Restrict)
  assignedByMember FamilyMember         @relation("TaskAssignedBy", fields: [assignedByMemberId], references: [id], onDelete: Restrict)
  submissions      TaskSubmission[]
  unavailabilities TaskUnavailability[]

  @@index([taskId])
  @@index([assignedToMemberId])
  @@index([assignedByMemberId])
  @@index([status])
  @@index([dueAt])
  @@map("task_assignments")
}

model TaskSubmission {
  id                  String               @id @default(uuid())
  assignmentId        String
  submittedByMemberId String
  submissionNote      String?
  status              TaskSubmissionStatus @default(WAITING_REVIEW)
  reviewedByMemberId  String?
  reviewNote          String?
  submittedAt         DateTime             @default(now())
  reviewedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  assignment        TaskAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submittedByMember FamilyMember      @relation("TaskSubmissionSubmittedBy", fields: [submittedByMemberId], references: [id], onDelete: Restrict)
  reviewedByMember  FamilyMember?     @relation("TaskSubmissionReviewedBy", fields: [reviewedByMemberId], references: [id], onDelete: Restrict)
  proofs            TaskProof[]
  rewardSettlement  RewardSettlement?

  @@index([assignmentId])
  @@index([submittedByMemberId])
  @@index([reviewedByMemberId])
  @@index([status])
  @@map("task_submissions")
}

model RewardSetting {
  id                   String     @id @default(uuid())
  taskId               String     @unique
  rewardType           RewardType
  rewardAmount         Decimal?   @db.Decimal(14, 2)
  rewardDescription    String?
  autoCreateSettlement Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  task        Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  settlements RewardSettlement[]

  @@index([taskId])
  @@map("reward_settings")
}

model RewardSettlement {
  id                String                 @id @default(uuid())
  taskSubmissionId  String                 @unique
  rewardSettingId   String
  receiverMemberId  String
  settledByMemberId String?
  amount            Decimal                @db.Decimal(14, 2)
  status            RewardSettlementStatus @default(PENDING_SETTLEMENT)
  externalMethod    RewardExternalMethod?
  externalNote      String?
  settledAt         DateTime?
  confirmedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  taskSubmission  TaskSubmission     @relation(fields: [taskSubmissionId], references: [id], onDelete: Cascade)
  rewardSetting   RewardSetting      @relation(fields: [rewardSettingId], references: [id], onDelete: Restrict)
  receiverMember  FamilyMember       @relation("RewardSettlementReceiver", fields: [receiverMemberId], references: [id], onDelete: Restrict)
  settledByMember FamilyMember?      @relation("RewardSettlementSettledBy", fields: [settledByMemberId], references: [id], onDelete: Restrict)
  allocations     RewardAllocation[]
  disputes        RewardDispute[]

  @@index([rewardSettingId])
  @@index([receiverMemberId])
  @@index([settledByMemberId])
  @@index([status])
  @@map("reward_settlements")
}

model RewardAllocation {
  id                  String   @id @default(uuid())
  rewardSettlementId  String
  jarId               String?
  goalId              String?
  ledgerEntryId       String?
  amount              Decimal  @db.Decimal(14, 2)
  allocatedByMemberId String
  allocatedAt         DateTime @default(now())

  rewardSettlement  RewardSettlement @relation(fields: [rewardSettlementId], references: [id], onDelete: Cascade)
  jar               FinanceJar?      @relation(fields: [jarId], references: [id], onDelete: SetNull)
  goal              FinancialGoal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
  ledgerEntry       LedgerEntry?     @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  allocatedByMember FamilyMember     @relation("RewardAllocationAllocatedBy", fields: [allocatedByMemberId], references: [id], onDelete: Restrict)

  @@index([rewardSettlementId])
  @@index([jarId])
  @@index([goalId])
  @@index([ledgerEntryId])
  @@index([allocatedByMemberId])
  @@map("reward_allocations")
}

model RewardDispute {
  id                 String              @id @default(uuid())
  rewardSettlementId String
  reportedByMemberId String
  reason             String
  status             RewardDisputeStatus @default(OPEN)
  resolvedByMemberId String?
  createdAt          DateTime            @default(now())
  resolvedAt         DateTime?

  rewardSettlement RewardSettlement @relation(fields: [rewardSettlementId], references: [id], onDelete: Cascade)
  reportedByMember FamilyMember     @relation("RewardDisputeReportedBy", fields: [reportedByMemberId], references: [id], onDelete: Restrict)
  resolvedByMember FamilyMember?    @relation("RewardDisputeResolvedBy", fields: [resolvedByMemberId], references: [id], onDelete: Restrict)

  @@index([rewardSettlementId])
  @@index([reportedByMemberId])
  @@index([resolvedByMemberId])
  @@index([status])
  @@map("reward_disputes")
}

model TaskUnavailability {
  id                 String                   @id @default(uuid())
  assignmentId       String
  reportedByMemberId String
  reason             String
  status             TaskUnavailabilityStatus @default(REPORTED)
  reportedAt         DateTime                 @default(now())
  handledByMemberId  String?
  handledAt          DateTime?

  assignment       TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reportedByMember FamilyMember   @relation("TaskUnavailabilityReportedBy", fields: [reportedByMemberId], references: [id], onDelete: Restrict)
  handledByMember  FamilyMember?  @relation("TaskUnavailabilityHandledBy", fields: [handledByMemberId], references: [id], onDelete: Restrict)

  @@index([assignmentId])
  @@index([reportedByMemberId])
  @@index([handledByMemberId])
  @@index([status])
  @@index([reportedAt])
  @@map("task_unavailabilities")
}

model TaskProof {
  id           String        @id @default(uuid())
  submissionId String
  proofType    TaskProofType
  fileUrl      String?
  thumbnailUrl String?
  note         String?
  uploadedAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  submission TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([proofType])
  @@map("task_proofs")
}

// ===========================================================================
// SOS / Safety Response + Notifications
// ===========================================================================

/// How a SOS alert was triggered (mobile app, wearable, simulated device demo).
enum SosSourceType {
  MOBILE_APP
  WEARABLE
  SIMULATED_DEVICE
}

/// Why a SOS alert was triggered.
enum SosTriggerReason {
  MANUAL
  FALL_DETECTION
}

/// Lifecycle of a SOS alert.
enum SosAlertStatus {
  ACTIVE
  RESOLVED
  CANCELED
  FALSE_ALARM
}

/// Severity classification shared by alerts and sensor events.
enum SosSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Type of member response to a SOS alert.
enum SosResponseType {
  VIEWED
  ON_THE_WAY
  CONFIRM_SAFE
  NEED_HELP
  RESOLVED
  CANCELED
}

enum WearableDeviceType {
  SMARTWATCH
  GPS_TRACKER
  BLE_DEVICE
  SIMULATED_DEVICE
}

enum DevicePairingStatus {
  PAIRED
  UNPAIRED
  LOST
}

enum WearableActivationStatus {
  PENDING
  PAIRED
  CLAIMED
  EXPIRED
}

/// Origin of a GPS location point (shared by SOS routes and daily tracking).
enum GpsSourceType {
  MOBILE_GPS
  WEARABLE_GPS
  SIMULATED_GPS
}

enum SensorEventType {
  SOS_BUTTON_PRESSED
  FALL_DETECTED
  HEART_RATE_ABNORMAL
  HARD_IMPACT
  ABNORMAL_MOVEMENT
}

enum NotificationType {
  SOS
  GENERAL
  ALBUM_TAG
  JOIN_REQUEST
  MEMBER
  TASK
  CALENDAR
  FINANCE
  CHAT
  CALL
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

/// Per-workspace SOS configuration (1-1 with a family workspace).
model SosSetting {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @map("sos_setting_id") @db.Uuid
  workspaceId             String   @unique @map("workspace_id")
  isEnabled               Boolean  @default(true) @map("is_enabled")
  notifyAllMembers        Boolean  @default(true) @map("notify_all_members")
  autoCreateAlertFromFall Boolean  @default(false) @map("auto_create_alert_from_fall")
  locationRequired        Boolean  @default(true) @map("location_required")
  createdByMemberId       String?  @map("created_by_member_id")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace         Family             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByMember   FamilyMember?      @relation("CreatedSosSettings", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  emergencyContacts EmergencyContact[]

  @@index([createdByMemberId])
  @@map("sos_settings")
}

/// Emergency contacts attached to a workspace's SOS settings.
model EmergencyContact {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @map("contact_id") @db.Uuid
  sosSettingId     String   @map("sos_setting_id") @db.Uuid
  contactName      String   @map("contact_name")
  phoneNumber      String   @map("phone_number")
  relationshipNote String?  @map("relationship_note")
  priorityOrder    Int      @map("priority_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sosSetting SosSetting @relation(fields: [sosSettingId], references: [id], onDelete: Cascade)

  @@index([sosSettingId])
  @@map("emergency_contacts")
}

/// Wearable / tracking devices paired to a member within a workspace.
model WearableDevice {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @map("device_id") @db.Uuid
  workspaceId      String              @map("workspace_id")
  ownerMemberId    String              @map("owner_member_id")
  ownerUserId      String              @map("owner_user_id")
  deviceName       String              @map("device_name")
  deviceType       WearableDeviceType  @map("device_type")
  deviceIdentifier String              @map("device_identifier")
  pairingStatus    DevicePairingStatus @map("pairing_status")
  gpsEnabled       Boolean             @map("gps_enabled")
  sosEnabled       Boolean             @map("sos_enabled")
  lastSeenAt       DateTime?           @map("last_seen_at") @db.Timestamptz
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  workspace   Family       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerUser   User         @relation("OwnedUserWearableDevices", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerMember FamilyMember @relation("OwnedWearableDevices", fields: [ownerMemberId], references: [id], onDelete: Cascade)

  sosAlerts            SosAlert[]
  sosLocationPoints    SosLocationPoint[]
  sensorEvents         SensorEvent[]
  memberLocationPoints MemberLocationPoint[]
  activationSessions   WearableActivationSession[]

  // Plus a partial unique index (one paired wearable per user account) added
  // via raw SQL in the migration: UNIQUE(owner_user_id) WHERE pairing_status='PAIRED'.
  @@unique([workspaceId, deviceIdentifier])
  @@index([workspaceId])
  @@index([ownerMemberId])
  @@index([ownerUserId])
  @@map("wearable_devices")
}

/// Short-lived activation session used by Wear OS before it has a user token.
model WearableActivationSession {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @map("activation_session_id") @db.Uuid
  code                  String                   @map("code")
  status                WearableActivationStatus @default(PENDING) @map("status")
  deviceName            String?                  @map("device_name")
  deviceType            WearableDeviceType       @default(SMARTWATCH) @map("device_type")
  workspaceId           String?                  @map("workspace_id")
  ownerMemberId         String?                  @map("owner_member_id")
  ownerUserId           String?                  @map("owner_user_id")
  wearableDeviceId      String?                  @map("wearable_device_id") @db.Uuid
  claimedRefreshTokenId String?                  @map("claimed_refresh_token_id")
  expiresAt             DateTime                 @map("expires_at") @db.Timestamptz
  claimedAt             DateTime?                @map("claimed_at") @db.Timestamptz
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  workspace           Family?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerMember         FamilyMember?   @relation("WearableActivationOwnerMember", fields: [ownerMemberId], references: [id], onDelete: Cascade)
  ownerUser           User?           @relation("WearableActivationOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)
  wearableDevice      WearableDevice? @relation(fields: [wearableDeviceId], references: [id], onDelete: SetNull)
  claimedRefreshToken RefreshToken?   @relation("WearableActivationClaimedRefreshToken", fields: [claimedRefreshTokenId], references: [id], onDelete: SetNull)

  @@index([code, status])
  @@index([expiresAt])
  @@index([ownerUserId])
  @@index([wearableDeviceId])
  @@index([claimedRefreshTokenId])
  @@map("wearable_activation_sessions")
}

/// Central SOS alert record. Resolved/canceled only by FAMILY_MANAGER/DEPUTY.
model SosAlert {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @map("sos_alert_id") @db.Uuid
  workspaceId         String           @map("workspace_id")
  triggeredByMemberId String           @map("triggered_by_member_id")
  deviceId            String?          @map("device_id") @db.Uuid
  sourceType          SosSourceType    @map("source_type")
  triggerReason       SosTriggerReason @default(MANUAL) @map("trigger_reason")
  status              SosAlertStatus   @default(ACTIVE) @map("status")
  severity            SosSeverity?     @map("severity")
  initialLatitude     Decimal?         @map("initial_latitude") @db.Decimal(10, 7)
  initialLongitude    Decimal?         @map("initial_longitude") @db.Decimal(10, 7)
  message             String?          @map("message")
  triggeredAt         DateTime         @default(now()) @map("triggered_at") @db.Timestamptz
  resolvedByMemberId  String?          @map("resolved_by_member_id")
  resolvedAt          DateTime?        @map("resolved_at") @db.Timestamptz
  resolutionNote      String?          @map("resolution_note")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  workspace         Family          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  triggeredByMember FamilyMember    @relation("TriggeredSosAlerts", fields: [triggeredByMemberId], references: [id], onDelete: Cascade)
  device            WearableDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  resolvedByMember  FamilyMember?   @relation("ResolvedSosAlerts", fields: [resolvedByMemberId], references: [id], onDelete: SetNull)

  locationPoints SosLocationPoint[]
  responses      SosResponse[]
  sensorEvents   SensorEvent[]      @relation("CreatedSosAlertSensorEvents")

  @@index([workspaceId])
  @@index([triggeredByMemberId])
  @@index([deviceId])
  @@index([status])
  @@index([triggeredAt])
  @@map("sos_alerts")
}

/// GPS route points captured during a single SOS event.
model SosLocationPoint {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @map("location_point_id") @db.Uuid
  sosAlertId String        @map("sos_alert_id") @db.Uuid
  deviceId   String?       @map("device_id") @db.Uuid
  latitude   Decimal       @map("latitude") @db.Decimal(10, 7)
  longitude  Decimal       @map("longitude") @db.Decimal(10, 7)
  accuracy   Decimal?      @map("accuracy") @db.Decimal(10, 2)
  sourceType GpsSourceType @map("source_type")
  recordedAt DateTime      @map("recorded_at") @db.Timestamptz
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz

  sosAlert SosAlert        @relation(fields: [sosAlertId], references: [id], onDelete: Cascade)
  device   WearableDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([sosAlertId])
  @@index([deviceId])
  @@index([recordedAt])
  @@map("sos_location_points")
}

/// Member responses to a SOS alert (viewed / safe / need help / resolved / canceled).
model SosResponse {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @map("response_id") @db.Uuid
  sosAlertId        String          @map("sos_alert_id") @db.Uuid
  responderMemberId String          @map("responder_member_id")
  responseType      SosResponseType @map("response_type")
  message           String?         @map("message")
  respondedAt       DateTime        @default(now()) @map("responded_at") @db.Timestamptz

  sosAlert        SosAlert     @relation(fields: [sosAlertId], references: [id], onDelete: Cascade)
  responderMember FamilyMember @relation("SosResponses", fields: [responderMemberId], references: [id], onDelete: Cascade)

  @@index([sosAlertId])
  @@index([responderMemberId])
  @@map("sos_responses")
}

/// Raw sensor events emitted by wearable / simulated devices.
model SensorEvent {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @map("sensor_event_id") @db.Uuid
  deviceId          String          @map("device_id") @db.Uuid
  eventType         SensorEventType @map("event_type")
  rawValue          Json?           @map("raw_value") @db.JsonB
  severity          SosSeverity?    @map("severity")
  detectedAt        DateTime        @map("detected_at") @db.Timestamptz
  createdSosAlertId String?         @map("created_sos_alert_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  device          WearableDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdSosAlert SosAlert?      @relation("CreatedSosAlertSensorEvents", fields: [createdSosAlertId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([createdSosAlertId])
  @@index([detectedAt])
  @@map("sensor_events")
}

/// Everyday member location tracking — separate from SOS-event route points.
model MemberLocationPoint {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @map("location_point_id") @db.Uuid
  workspaceId String        @map("workspace_id")
  memberId    String        @map("member_id")
  deviceId    String?       @map("device_id") @db.Uuid
  latitude    Decimal       @map("latitude") @db.Decimal(10, 7)
  longitude   Decimal       @map("longitude") @db.Decimal(10, 7)
  accuracy    Decimal?      @map("accuracy") @db.Decimal(10, 2)
  sourceType  GpsSourceType @map("source_type")
  recordedAt  DateTime      @map("recorded_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  workspace Family          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    FamilyMember    @relation("MemberLocationPoints", fields: [memberId], references: [id], onDelete: Cascade)
  device    WearableDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  // Plus CHECK constraints added via raw SQL in the migration:
  // latitude BETWEEN -90 AND 90, longitude BETWEEN -180 AND 180.
  @@index([workspaceId])
  @@index([memberId])
  @@index([deviceId])
  @@index([recordedAt])
  @@map("member_location_points")
}

/// Shared in-app notifications (reused across modules; SOS uses type=SOS).
model Notification {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @map("notification_id") @db.Uuid
  familyId          String               @map("family_id")
  recipientMemberId String               @map("recipient_member_id")
  type              NotificationType     @map("type")
  priority          NotificationPriority @default(NORMAL) @map("priority")
  title             String               @map("title")
  body              String               @map("body")
  referenceType     String?              @map("reference_type")
  referenceId       String?              @map("reference_id")
  isRead            Boolean              @default(false) @map("is_read")
  readAt            DateTime?            @map("read_at") @db.Timestamptz
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz

  family          Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  recipientMember FamilyMember @relation("MemberNotifications", fields: [recipientMemberId], references: [id], onDelete: Cascade)

  @@index([recipientMemberId, isRead])
  @@index([familyId])
  @@map("notifications")
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

/// Thiết bị nhận FCM push — gắn theo USER (nhận noti của mọi family mình tham gia).
model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform
  deviceName String?
  lastSeenAt DateTime       @updatedAt
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ===========================================================================
// Workspace provisioning (admin) + Communication + Calendar + Album + AI
// (bổ sung theo Physical ERD — style snake_case @map giống nhóm SOS)
