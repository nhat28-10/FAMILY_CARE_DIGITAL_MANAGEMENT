// Prisma schema for Family Finance Management Platform
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Enums — 3-layer role model
// ===========================================================================

/// Account-level user type (ERD: user_type). System-wide; family roles live on
/// FamilyMember.familyRole, not here.
enum UserType {
  NORMAL_USER
  SYSTEM_ADMIN
}

/// Account lifecycle status (ERD: account_status).
enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Role of a user inside a specific family (ERD: family_role).
enum FamilyRole {
  FAMILY_MANAGER
  DEPUTY_MEMBER
  FAMILY_MEMBER
}

/// Family relationship — display only (ERD: relationship_type).
enum Relationship {
  FATHER
  MOTHER
  SPOUSE
  CHILD
  SISTER
  BROTHER
  GRANDPARENT
  OTHER
}

/// Lifecycle status of a family invitation.
enum InvitationStatus {
  PENDING
  /// Invitee has sent a join request (awaiting manager approval).
  CLAIMED
  /// Manager approved the claim → family member created.
  APPROVED
  /// Manager rejected the claim.
  REJECTED
  /// @deprecated Legacy single-step accept; kept for back-compat, no longer set.
  ACCEPTED
  EXPIRED
  CANCELED
}

/// Email/phone verification status of a user account (ERD: verification_status).
enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

/// Operational lifecycle of a family workspace (ERD: workspace_status).
enum WorkspaceStatus {
  ACTIVE
  PENDING
  SUSPENDED
  EXPIRED
}

/// Provisioning/activation result of a family workspace (ERD: activation_status).
enum ActivationStatus {
  ACTIVE
  PENDING
  FAILED
}

/// Membership lifecycle of a family member (ERD: member_status).
enum MemberStatus {
  ACTIVE
  INACTIVE
  REMOVED
}

/// Controls whether a member's monthly finance summary is private or visible
/// within their family workspace.
enum FinanceVisibility {
  PRIVATE
  FAMILY
}

/// Lifecycle status of the single shared finance ledger owned by a family.
enum FinanceLedgerStatus {
  ACTIVE
  INACTIVE
}

/// Whether a finance category records incoming or outgoing money.
enum FinanceCategoryType {
  INCOME
  EXPENSE
}

/// Essential classification used for family expense analysis.
enum EssentialType {
  ESSENTIAL
  NON_ESSENTIAL
  NEUTRAL
}

/// Lifecycle status of a family-defined finance category.
enum FinanceCategoryStatus {
  ACTIVE
  INACTIVE
}

/// Business classification of a shared family ledger entry.
enum LedgerEntryType {
  INCOME
  EXPENSE
  CONTRIBUTION
  ALLOWANCE
  REWARD
  SUPPORT
  ADJUSTMENT
}

/// Ledger entries are retained for traceability and voided instead of deleted.
enum LedgerEntryStatus {
  ACTIVE
  VOIDED
}

/// Allocation strategy used by a family for its internal finance planning.
enum FinanceModelType {
  FIVE_JARS
  EIGHTY_TWENTY
  CUSTOM
}

/// Lifecycle of a family's finance allocation configuration.
enum FinanceModelStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum BudgetPeriodType {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BudgetPlanStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELED
}

enum FinancialGoalStatus {
  ACTIVE
  ACHIEVED
  CANCELED
  AT_RISK
}

enum BudgetAlertType {
  OVER_BUDGET
  GOAL_AT_RISK
  NON_ESSENTIAL_TOO_HIGH
}

enum BudgetAlertSeverity {
  LOW
  MEDIUM
  HIGH
}

enum BudgetAlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
}

enum SpendingSupportRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum TaskCategoryStatus {
  ACTIVE
  INACTIVE
}

enum TaskType {
  AD_HOC
  RECURRING
}

enum TaskRepeatType {
  DAILY
  WEEKLY
  MONTHLY
}

enum TaskScheduleStatus {
  ACTIVE
  INACTIVE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELED
}

enum TaskAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  CANCELED
}

enum TaskSubmissionStatus {
  WAITING_REVIEW
  APPROVED
  REJECTED
}

enum TaskUnavailabilityStatus {
  REPORTED
  HANDLED
  CANCELED
}

enum RewardType {
  MONEY_RECORD
  POINT
  OTHER
}

enum RewardSettlementStatus {
  PENDING_SETTLEMENT
  WAITING_CONFIRMATION
  SETTLED
  DISPUTED
  CANCELED
}

enum RewardDisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum RewardExternalMethod {
  CASH
  BANK_TRANSFER
  THIRD_PARTY_WALLET
  OTHER
}

enum TaskProofType {
  IMAGE
  VIDEO
  NOTE
  FILE
}

/// Subscription plan tier offered to family workspaces (ERD: plan_code).
enum SubscriptionPlanCode {
  FREE
  PLUS
  PREMIUM
}

// ===========================================================================
// Models
// ===========================================================================

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  fullName           String?
  /// ERD: phone_number — optional, unique when present.
  phone              String?            @unique
  /// ERD: avatar_url.
  avatarUrl          String?
  /// ERD: user_type — NORMAL_USER vs SYSTEM_ADMIN (not a family role).
  userType           UserType           @default(NORMAL_USER)
  /// ERD: account_status.
  accountStatus      AccountStatus      @default(ACTIVE)
  /// ERD: verification_status.
  verificationStatus VerificationStatus @default(UNVERIFIED)
  /// ERD: last_login_at — set on each successful login.
  lastLoginAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  memberships             FamilyMember[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  claimedInvitations      Invitation[]             @relation("ClaimedBy")

  @@map("users")
}

/// Mã OTP xác thực email (6 số). Chỉ lưu sha256 của mã, không lưu mã thật.
/// `usedAt` đánh dấu đã dùng; `attempts` đếm số lần nhập sai để khóa tạm.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// One-time password reset tokens (ERD: PasswordResetToken). The raw token is
/// never stored — only its sha256/bcrypt hash. `usedAt` marks single use.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// One row per active refresh token (per device/session). The raw token is
/// never stored — only its bcrypt hash. Supports multi-device + per-session
/// revocation and rotation.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Family {
  id               String           @id @default(uuid())
  name             String
  /// ERD: description.
  description      String?
  /// ERD: avatar_url.
  avatarUrl        String?
  /// ERD: workspace_status.
  status           WorkspaceStatus  @default(ACTIVE)
  /// ERD: activation_status.
  activationStatus ActivationStatus @default(ACTIVE)
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  members                 FamilyMember[]
  invitations             Invitation[]
  financeLedger           FinanceLedger?
  financeCategories       FinanceCategory[]
  financeModels           FinanceModel[]
  budgetPlans             BudgetPlan[]
  financialGoals          FinancialGoal[]
  budgetAlerts            BudgetAlert[]
  spendingSupportRequests SpendingSupportRequest[]
  taskCategories          TaskCategory[]
  tasks                   Task[]
  sosSetting              SosSetting?
  wearableDevices         WearableDevice[]
  sosAlerts               SosAlert[]
  memberLocationPoints    MemberLocationPoint[]
  notifications           Notification[]
  subscription            FamilySubscription?
  paymentTransactions     PaymentTransaction[]

  @@map("families")
}

model FamilyMember {
  id           String       @id @default(uuid())
  familyId     String
  userId       String
  /// ERD: display_name — per-family display name override.
  displayName  String?
  familyRole   FamilyRole   @default(FAMILY_MEMBER)
  relationship Relationship @default(OTHER)
  /// ERD: member_status.
  status       MemberStatus @default(ACTIVE)
  joinedAt     DateTime     @default(now())
  /// ERD: left_at — set when the member leaves/is removed.
  leftAt       DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Invitations created by this member (ERD: created_by_member_id).
  createdInvitations               Invitation[]             @relation("CreatedByMember")
  approvedInvitations              Invitation[]             @relation("ApprovedByInvitations")
  monthlyFinances                  MemberMonthlyFinance[]
  createdLedgerEntries             LedgerEntry[]            @relation("CreatedLedgerEntries")
  createdBudgetPlans               BudgetPlan[]             @relation("CreatedBudgetPlans")
  createdFinancialGoals            FinancialGoal[]          @relation("CreatedFinancialGoals")
  goalAllocations                  GoalAllocation[]         @relation("GoalAllocations")
  requestedSpendingSupportRequests SpendingSupportRequest[] @relation("RequestedSpendingSupportRequests")
  reviewedSpendingSupportRequests  SpendingSupportRequest[] @relation("ReviewedSpendingSupportRequests")
  createdTasks                     Task[]                   @relation("CreatedTasks")
  assignedTasks                    TaskAssignment[]         @relation("TaskAssignedTo")
  givenTaskAssignments             TaskAssignment[]         @relation("TaskAssignedBy")
  submittedTaskSubmissions         TaskSubmission[]         @relation("TaskSubmissionSubmittedBy")
  reviewedTaskSubmissions          TaskSubmission[]         @relation("TaskSubmissionReviewedBy")
  reportedTaskUnavailabilities     TaskUnavailability[]     @relation("TaskUnavailabilityReportedBy")
  handledTaskUnavailabilities      TaskUnavailability[]     @relation("TaskUnavailabilityHandledBy")
  receivedRewardSettlements        RewardSettlement[]       @relation("RewardSettlementReceiver")
  settledRewardSettlements         RewardSettlement[]       @relation("RewardSettlementSettledBy")
  rewardAllocations                RewardAllocation[]       @relation("RewardAllocationAllocatedBy")
  reportedRewardDisputes           RewardDispute[]          @relation("RewardDisputeReportedBy")
  resolvedRewardDisputes           RewardDispute[]          @relation("RewardDisputeResolvedBy")
  createdSosSettings               SosSetting[]             @relation("CreatedSosSettings")
  ownedWearableDevices             WearableDevice[]         @relation("OwnedWearableDevices")
  triggeredSosAlerts               SosAlert[]               @relation("TriggeredSosAlerts")
  resolvedSosAlerts                SosAlert[]               @relation("ResolvedSosAlerts")
  sosResponses                     SosResponse[]            @relation("SosResponses")
  memberLocationPoints             MemberLocationPoint[]    @relation("MemberLocationPoints")
  notifications                    Notification[]           @relation("MemberNotifications")

  @@unique([familyId, userId])
  @@index([userId])
  @@map("family_members")
}

model Invitation {
  id                String           @id @default(uuid())
  familyId          String
  email             String
  /// ERD: invited_phone — optional alternative contact.
  invitedPhone      String?
  /// sha256 hash of the opaque invitation token (raw token returned once).
  tokenHash         String           @unique
  familyRole        FamilyRole       @default(FAMILY_MEMBER)
  relationship      Relationship     @default(OTHER)
  status            InvitationStatus @default(PENDING)
  /// ERD: created_by_member_id — the family member who issued the invite.
  createdByMemberId String
  /// ERD: claimed_by_user_id — the user who sent the join request.
  claimedById       String?
  /// ERD: claimed_at — when the join request was sent.
  claimedAt         DateTime?
  /// ERD: approved_by_member_id — the manager who approved the claim.
  approvedByMemberId String?
  /// ERD: approved_at — when the claim was approved.
  approvedAt        DateTime?
  expiresAt         DateTime
  createdAt         DateTime         @default(now())

  family          Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdByMember  FamilyMember  @relation("CreatedByMember", fields: [createdByMemberId], references: [id], onDelete: Cascade)
  claimedBy        User?         @relation("ClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  approvedByMember FamilyMember? @relation("ApprovedByInvitations", fields: [approvedByMemberId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@map("invitations")
}

/// Monthly personal income and expense summary for a family member. This is a
/// summary only; personal ledger entries are intentionally not modeled.
model MemberMonthlyFinance {
  id                      String            @id @default(uuid())
  memberId                String
  periodMonth             Int
  periodYear              Int
  expectedIncome          Decimal?          @db.Decimal(18, 2)
  actualIncome            Decimal?          @db.Decimal(18, 2)
  expectedPersonalExpense Decimal?          @db.Decimal(18, 2)
  actualPersonalExpense   Decimal?          @db.Decimal(18, 2)
  incomeVisibility        FinanceVisibility @default(PRIVATE)
  expenseVisibility       FinanceVisibility @default(PRIVATE)
  note                    String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, periodMonth, periodYear])
  @@index([periodYear, periodMonth])
  @@map("member_monthly_finances")
}

/// The single shared finance ledger for a family workspace. Family finance is
/// an internal record system and does not represent a real-money wallet.
model FinanceLedger {
  id         String              @id @default(uuid())
  familyId   String              @unique
  ledgerName String
  status     FinanceLedgerStatus @default(ACTIVE)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  entries      LedgerEntry[]
  budgetLines  BudgetLine[]
  budgetAlerts BudgetAlert[]

  @@map("finance_ledgers")
}

/// Family-defined classification for shared ledger entries.
model FinanceCategory {
  id            String                @id @default(uuid())
  familyId      String
  name          String
  categoryType  FinanceCategoryType
  essentialType EssentialType         @default(NEUTRAL)
  status        FinanceCategoryStatus @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  family                  Family                   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  entries                 LedgerEntry[]
  budgetLines             BudgetLine[]
  budgetAlerts            BudgetAlert[]
  spendingSupportRequests SpendingSupportRequest[]

  @@unique([familyId, name, categoryType])
  @@index([familyId, categoryType, status])
  @@map("finance_categories")
}

/// Historical finance allocation configuration for a family. Only one model
/// may be active for a family at a time.
model FinanceModel {
  id        String             @id @default(uuid())
  familyId  String
  modelType FinanceModelType
  name      String
  status    FinanceModelStatus @default(DRAFT)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  family Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  jars   FinanceJar[]

  @@index([familyId, status])
  @@map("finance_models")
}

/// Jar/fund allocation belonging to one finance model. Percentages are
/// planning values only and never represent stored real money.
model FinanceJar {
  id                   String   @id @default(uuid())
  financeModelId       String
  name                 String
  jarCode              String
  allocationPercentage Decimal  @db.Decimal(5, 2)
  description          String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  financeModel      FinanceModel       @relation(fields: [financeModelId], references: [id], onDelete: Cascade)
  budgetLines       BudgetLine[]
  financialGoals    FinancialGoal[]
  budgetAlerts      BudgetAlert[]
  rewardAllocations RewardAllocation[]

  @@unique([financeModelId, jarCode])
  @@index([financeModelId, isActive])
  @@map("finance_jars")
}

/// Immutable-style record in the shared family ledger. Corrections should be
/// represented by voiding or adjustment entries rather than deleting history.
model LedgerEntry {
  id                String            @id @default(uuid())
  ledgerId          String
  categoryId        String?
  createdByMemberId String
  entryType         LedgerEntryType
  amount            Decimal           @db.Decimal(18, 2)
  description       String
  note              String?
  entryDate         DateTime
  status            LedgerEntryStatus @default(ACTIVE)
  sourceType        String?
  sourceId          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  ledger            FinanceLedger      @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  category          FinanceCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdByMember   FamilyMember       @relation("CreatedLedgerEntries", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  goalAllocations   GoalAllocation[]
  rewardAllocations RewardAllocation[]

  @@index([ledgerId, entryDate])
  @@index([ledgerId, entryType, status])
  @@index([categoryId])
  @@index([createdByMemberId])
  @@index([sourceType, sourceId])
  @@map("ledger_entries")
}

/// Subscription plan tier (ERD: SubscriptionPlan). Paid plans are annual-only;
/// admins (SYSTEM_ADMIN) manage these, family workspaces subscribe to them.
model SubscriptionPlan {
  id            String               @id @default(uuid())
  planCode      SubscriptionPlanCode @unique
  name          String
  /// ERD: annual_price — paid plans are billed yearly.
  annualPrice   Decimal              @db.Decimal(18, 2)
  /// ERD: max_members — member cap enforced per workspace subscription.
  maxMembers    Int
  /// ERD: storage_limit — storage allowance in megabytes.
  storageLimit  Int
  /// ERD: feature_access — feature flags/limits map for the tier.
  featureAccess Json?
  /// Stripe recurring (annual) Price id — required for paid tiers (PLUS/PREMIUM).
  stripePriceId String?              @unique
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  familySubscriptions FamilySubscription[]

  @@map("subscription_plans")
}

/// Lifecycle state of a family's subscription (mirrors Stripe subscription status).
enum FamilySubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

/// One row per family (always present). New families start on FREE with no
/// expiry; buying a paid plan moves the row to PLUS/PREMIUM and fills the Stripe
/// ids. Webhooks are the source of truth for status/period changes.
model FamilySubscription {
  id                   String                   @id @default(uuid())
  familyId             String                   @unique
  planId               String
  status               FamilySubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?                  @unique
  /// null for FREE (no expiry); set from Stripe current_period_end for paid plans.
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  family Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("family_subscriptions")
}

/// Payment/webhook history. `stripeEventId` is unique so replayed Stripe webhook
/// events are idempotent (duplicate inserts fail and are skipped).
model PaymentTransaction {
  id            String   @id @default(uuid())
  familyId      String
  stripeEventId String   @unique
  type          String
  amount        Decimal? @db.Decimal(18, 2)
  currency      String?
  status        String
  rawPayload    Json
  createdAt     DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("payment_transactions")
}

model SpendingSupportRequest {
  id                 String                       @id @default(uuid())
  familyId           String
  requesterMemberId  String
  amount             Decimal                      @db.Decimal(18, 2)
  categoryId         String?
  purpose            String
  status             SpendingSupportRequestStatus @default(PENDING)
  reviewedByMemberId String?
  reviewedAt         DateTime?
  decisionNote       String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  family           Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  requesterMember  FamilyMember     @relation("RequestedSpendingSupportRequests", fields: [requesterMemberId], references: [id], onDelete: Restrict)
  reviewedByMember FamilyMember?    @relation("ReviewedSpendingSupportRequests", fields: [reviewedByMemberId], references: [id], onDelete: Restrict)
  category         FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([requesterMemberId])
  @@index([reviewedByMemberId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@map("spending_support_requests")
}

/// Family-level budget plan for an internal planning period.
model BudgetPlan {
  id                    String           @id @default(uuid())
  familyId              String
  planName              String
  periodType            BudgetPeriodType
  periodStart           DateTime         @db.Date
  periodEnd             DateTime         @db.Date
  expectedSharedIncome  Decimal?         @db.Decimal(18, 2)
  expectedSharedExpense Decimal?         @db.Decimal(18, 2)
  status                BudgetPlanStatus @default(DRAFT)
  createdByMemberId     String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  family          Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdByMember FamilyMember  @relation("CreatedBudgetPlans", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  lines           BudgetLine[]
  budgetAlerts    BudgetAlert[]

  @@index([familyId])
  @@index([periodStart, periodEnd])
  @@index([status])
  @@map("budget_plans")
}

/// Planned amount assigned to a family category, finance jar, or both.
model BudgetLine {
  id               String         @id @default(uuid())
  budgetPlanId     String
  categoryId       String?
  jarId            String?
  plannedAmount    Decimal        @db.Decimal(18, 2)
  thresholdAmount  Decimal?       @db.Decimal(18, 2)
  thresholdPercent Decimal?       @db.Decimal(5, 2)
  essentialType    EssentialType?
  note             String?

  budgetPlan      BudgetPlan       @relation(fields: [budgetPlanId], references: [id], onDelete: Cascade)
  category        FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  jar             FinanceJar?      @relation(fields: [jarId], references: [id], onDelete: SetNull)
  financeLedger   FinanceLedger?   @relation(fields: [financeLedgerId], references: [id])
  financeLedgerId String?

  @@index([budgetPlanId])
  @@index([categoryId])
  @@index([jarId])
  @@map("budget_lines")
}

model FinancialGoal {
  id                        String              @id @default(uuid())
  familyId                  String
  goalName                  String
  targetAmount              Decimal             @db.Decimal(18, 2)
  deadline                  DateTime?           @db.Date
  monthlyContributionTarget Decimal?            @db.Decimal(18, 2)
  relatedJarId              String?
  status                    FinancialGoalStatus @default(ACTIVE)
  createdByMemberId         String
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  family            Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  relatedJar        FinanceJar?        @relation(fields: [relatedJarId], references: [id], onDelete: SetNull)
  createdByMember   FamilyMember       @relation("CreatedFinancialGoals", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  allocations       GoalAllocation[]
  budgetAlerts      BudgetAlert[]
  rewardAllocations RewardAllocation[]

  @@index([familyId])
  @@index([relatedJarId])
  @@index([status])
  @@index([deadline])
  @@map("financial_goals")
}

model GoalAllocation {
  id                  String   @id @default(uuid())
  goalId              String
  ledgerEntryId       String
  amount              Decimal  @db.Decimal(18, 2)
  allocatedByMemberId String
  allocatedAt         DateTime @default(now())

  goal              FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  ledgerEntry       LedgerEntry   @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)
  allocatedByMember FamilyMember  @relation("GoalAllocations", fields: [allocatedByMemberId], references: [id], onDelete: Restrict)

  @@index([goalId])
  @@index([ledgerEntryId])
  @@index([allocatedByMemberId])
  @@map("goal_allocations")
}

model BudgetAlert {
  id             String              @id @default(uuid())
  familyId       String
  sourceKey      String
  budgetPlanId   String?
  goalId         String?
  jarId          String?
  categoryId     String?
  alertType      BudgetAlertType
  severity       BudgetAlertSeverity
  thresholdValue Decimal?            @db.Decimal(18, 2)
  actualValue    Decimal?            @db.Decimal(18, 2)
  message        String?
  resolutionNote String?
  status         BudgetAlertStatus   @default(NEW)
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?

  family          Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  budgetPlan      BudgetPlan?      @relation(fields: [budgetPlanId], references: [id], onDelete: SetNull)
  goal            FinancialGoal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
  jar             FinanceJar?      @relation(fields: [jarId], references: [id], onDelete: SetNull)
  category        FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  financeLedger   FinanceLedger?   @relation(fields: [financeLedgerId], references: [id])
  financeLedgerId String?

  @@index([familyId])
  @@index([sourceKey])
  @@index([budgetPlanId])
  @@index([goalId])
  @@index([jarId])
  @@index([categoryId])
  @@index([alertType])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
  @@map("budget_alerts")
}

model TaskCategory {
  id          String             @id @default(uuid())
  familyId    String
  name        String
  description String?
  status      TaskCategoryStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@unique([familyId, name])
  @@index([familyId, status])
  @@map("task_categories")
}

model Task {
  id                String       @id @default(uuid())
  familyId          String
  taskCategoryId    String?
  title             String
  description       String?
  taskType          TaskType     @default(AD_HOC)
  priority          TaskPriority @default(MEDIUM)
  status            TaskStatus   @default(ACTIVE)
  createdByMemberId String
  dueAt             DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  family          Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category        TaskCategory?    @relation(fields: [taskCategoryId], references: [id], onDelete: SetNull)
  createdByMember FamilyMember     @relation("CreatedTasks", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  assignments     TaskAssignment[]
  schedule        TaskSchedule?
  rewardSetting   RewardSetting?

  @@index([familyId])
  @@index([taskCategoryId])
  @@index([createdByMemberId])
  @@index([status])
  @@index([dueAt])
  @@map("tasks")
}

model TaskSchedule {
  id             String             @id @default(uuid())
  taskId         String             @unique
  repeatType     TaskRepeatType
  repeatInterval Int
  startDate      DateTime           @db.Date
  endDate        DateTime?          @db.Date
  dayOfWeek      Int?
  status         TaskScheduleStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([status])
  @@index([startDate])
  @@map("task_schedules")
}

model TaskAssignment {
  id                 String               @id @default(uuid())
  taskId             String
  assignedToMemberId String
  assignedByMemberId String
  status             TaskAssignmentStatus @default(ASSIGNED)
  assignedAt         DateTime             @default(now())
  startAt            DateTime?
  dueAt              DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  task             Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignedToMember FamilyMember         @relation("TaskAssignedTo", fields: [assignedToMemberId], references: [id], onDelete: Restrict)
  assignedByMember FamilyMember         @relation("TaskAssignedBy", fields: [assignedByMemberId], references: [id], onDelete: Restrict)
  submissions      TaskSubmission[]
  unavailabilities TaskUnavailability[]

  @@index([taskId])
  @@index([assignedToMemberId])
  @@index([assignedByMemberId])
  @@index([status])
  @@index([dueAt])
  @@map("task_assignments")
}

model TaskSubmission {
  id                  String               @id @default(uuid())
  assignmentId        String
  submittedByMemberId String
  submissionNote      String?
  status              TaskSubmissionStatus @default(WAITING_REVIEW)
  reviewedByMemberId  String?
  reviewNote          String?
  submittedAt         DateTime             @default(now())
  reviewedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  assignment        TaskAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submittedByMember FamilyMember      @relation("TaskSubmissionSubmittedBy", fields: [submittedByMemberId], references: [id], onDelete: Restrict)
  reviewedByMember  FamilyMember?     @relation("TaskSubmissionReviewedBy", fields: [reviewedByMemberId], references: [id], onDelete: Restrict)
  proofs            TaskProof[]
  rewardSettlement  RewardSettlement?

  @@index([assignmentId])
  @@index([submittedByMemberId])
  @@index([reviewedByMemberId])
  @@index([status])
  @@map("task_submissions")
}

model RewardSetting {
  id                   String     @id @default(uuid())
  taskId               String     @unique
  rewardType           RewardType
  rewardAmount         Decimal?   @db.Decimal(14, 2)
  rewardDescription    String?
  autoCreateSettlement Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  task        Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  settlements RewardSettlement[]

  @@index([taskId])
  @@map("reward_settings")
}

model RewardSettlement {
  id                String                 @id @default(uuid())
  taskSubmissionId  String                 @unique
  rewardSettingId   String
  receiverMemberId  String
  settledByMemberId String?
  amount            Decimal                @db.Decimal(14, 2)
  status            RewardSettlementStatus @default(PENDING_SETTLEMENT)
  externalMethod    RewardExternalMethod?
  externalNote      String?
  settledAt         DateTime?
  confirmedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  taskSubmission  TaskSubmission     @relation(fields: [taskSubmissionId], references: [id], onDelete: Cascade)
  rewardSetting   RewardSetting      @relation(fields: [rewardSettingId], references: [id], onDelete: Restrict)
  receiverMember  FamilyMember       @relation("RewardSettlementReceiver", fields: [receiverMemberId], references: [id], onDelete: Restrict)
  settledByMember FamilyMember?      @relation("RewardSettlementSettledBy", fields: [settledByMemberId], references: [id], onDelete: Restrict)
  allocations     RewardAllocation[]
  disputes        RewardDispute[]

  @@index([rewardSettingId])
  @@index([receiverMemberId])
  @@index([settledByMemberId])
  @@index([status])
  @@map("reward_settlements")
}

model RewardAllocation {
  id                  String   @id @default(uuid())
  rewardSettlementId  String
  jarId               String?
  goalId              String?
  ledgerEntryId       String?
  amount              Decimal  @db.Decimal(14, 2)
  allocatedByMemberId String
  allocatedAt         DateTime @default(now())

  rewardSettlement  RewardSettlement @relation(fields: [rewardSettlementId], references: [id], onDelete: Cascade)
  jar               FinanceJar?      @relation(fields: [jarId], references: [id], onDelete: SetNull)
  goal              FinancialGoal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
  ledgerEntry       LedgerEntry?     @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  allocatedByMember FamilyMember     @relation("RewardAllocationAllocatedBy", fields: [allocatedByMemberId], references: [id], onDelete: Restrict)

  @@index([rewardSettlementId])
  @@index([jarId])
  @@index([goalId])
  @@index([ledgerEntryId])
  @@index([allocatedByMemberId])
  @@map("reward_allocations")
}

model RewardDispute {
  id                 String              @id @default(uuid())
  rewardSettlementId String
  reportedByMemberId String
  reason             String
  status             RewardDisputeStatus @default(OPEN)
  resolvedByMemberId String?
  createdAt          DateTime            @default(now())
  resolvedAt         DateTime?

  rewardSettlement RewardSettlement @relation(fields: [rewardSettlementId], references: [id], onDelete: Cascade)
  reportedByMember FamilyMember     @relation("RewardDisputeReportedBy", fields: [reportedByMemberId], references: [id], onDelete: Restrict)
  resolvedByMember FamilyMember?    @relation("RewardDisputeResolvedBy", fields: [resolvedByMemberId], references: [id], onDelete: Restrict)

  @@index([rewardSettlementId])
  @@index([reportedByMemberId])
  @@index([resolvedByMemberId])
  @@index([status])
  @@map("reward_disputes")
}

model TaskUnavailability {
  id                 String                   @id @default(uuid())
  assignmentId       String
  reportedByMemberId String
  reason             String
  status             TaskUnavailabilityStatus @default(REPORTED)
  reportedAt         DateTime                 @default(now())
  handledByMemberId  String?
  handledAt          DateTime?

  assignment       TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reportedByMember FamilyMember   @relation("TaskUnavailabilityReportedBy", fields: [reportedByMemberId], references: [id], onDelete: Restrict)
  handledByMember  FamilyMember?  @relation("TaskUnavailabilityHandledBy", fields: [handledByMemberId], references: [id], onDelete: Restrict)

  @@index([assignmentId])
  @@index([reportedByMemberId])
  @@index([handledByMemberId])
  @@index([status])
  @@index([reportedAt])
  @@map("task_unavailabilities")
}

model TaskProof {
  id           String        @id @default(uuid())
  submissionId String
  proofType    TaskProofType
  fileUrl      String?
  thumbnailUrl String?
  note         String?
  uploadedAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  submission TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([proofType])
  @@map("task_proofs")
}

// ===========================================================================
// SOS / Safety Response + Notifications
// ===========================================================================

/// How a SOS alert was triggered (mobile app, wearable, simulated device demo).
enum SosSourceType {
  MOBILE_APP
  WEARABLE
  SIMULATED_DEVICE
}

/// Lifecycle of a SOS alert.
enum SosAlertStatus {
  ACTIVE
  RESOLVED
  CANCELED
  FALSE_ALARM
}

/// Severity classification shared by alerts and sensor events.
enum SosSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Type of member response to a SOS alert.
enum SosResponseType {
  VIEWED
  CONFIRM_SAFE
  NEED_HELP
  RESOLVED
  CANCELED
}

enum WearableDeviceType {
  SMARTWATCH
  GPS_TRACKER
  BLE_DEVICE
  SIMULATED_DEVICE
}

enum DevicePairingStatus {
  PAIRED
  UNPAIRED
  LOST
}

/// Origin of a GPS location point (shared by SOS routes and daily tracking).
enum GpsSourceType {
  MOBILE_GPS
  WEARABLE_GPS
  SIMULATED_GPS
}

enum SensorEventType {
  SOS_BUTTON_PRESSED
  FALL_DETECTED
  HARD_IMPACT
  ABNORMAL_MOVEMENT
}

enum NotificationType {
  SOS
  GENERAL
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

/// Per-workspace SOS configuration (1-1 with a family workspace).
model SosSetting {
  sosSettingId            String   @id @default(dbgenerated("gen_random_uuid()")) @map("sos_setting_id") @db.Uuid
  workspaceId             String   @unique @map("workspace_id")
  isEnabled               Boolean  @default(true) @map("is_enabled")
  notifyAllMembers        Boolean  @default(true) @map("notify_all_members")
  autoCreateAlertFromFall Boolean  @default(false) @map("auto_create_alert_from_fall")
  locationRequired        Boolean  @default(true) @map("location_required")
  createdByMemberId       String?  @map("created_by_member_id")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace         Family             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByMember   FamilyMember?      @relation("CreatedSosSettings", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  emergencyContacts EmergencyContact[]

  @@index([createdByMemberId])
  @@map("sos_settings")
}

/// Emergency contacts attached to a workspace's SOS settings.
model EmergencyContact {
  contactId        String   @id @default(dbgenerated("gen_random_uuid()")) @map("contact_id") @db.Uuid
  sosSettingId     String   @map("sos_setting_id") @db.Uuid
  contactName      String   @map("contact_name")
  phoneNumber      String   @map("phone_number")
  relationshipNote String?  @map("relationship_note")
  priorityOrder    Int      @map("priority_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sosSetting SosSetting @relation(fields: [sosSettingId], references: [sosSettingId], onDelete: Cascade)

  @@index([sosSettingId])
  @@map("emergency_contacts")
}

/// Wearable / tracking devices paired to a member within a workspace.
model WearableDevice {
  deviceId         String              @id @default(dbgenerated("gen_random_uuid()")) @map("device_id") @db.Uuid
  workspaceId      String              @map("workspace_id")
  ownerMemberId    String              @map("owner_member_id")
  deviceName       String              @map("device_name")
  deviceType       WearableDeviceType  @map("device_type")
  deviceIdentifier String              @map("device_identifier")
  pairingStatus    DevicePairingStatus @map("pairing_status")
  gpsEnabled       Boolean             @map("gps_enabled")
  sosEnabled       Boolean             @map("sos_enabled")
  lastSeenAt       DateTime?           @map("last_seen_at") @db.Timestamptz
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  workspace   Family       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerMember FamilyMember @relation("OwnedWearableDevices", fields: [ownerMemberId], references: [id], onDelete: Cascade)

  sosAlerts            SosAlert[]
  sosLocationPoints    SosLocationPoint[]
  sensorEvents         SensorEvent[]
  memberLocationPoints MemberLocationPoint[]

  // Plus a partial unique index (one active SOS device per owner) added via raw
  // SQL in the migration: UNIQUE(owner_member_id) WHERE pairing_status='PAIRED'
  // AND sos_enabled=true.
  @@unique([workspaceId, deviceIdentifier])
  @@index([workspaceId])
  @@index([ownerMemberId])
  @@map("wearable_devices")
}

/// Central SOS alert record. Resolved/canceled only by FAMILY_MANAGER/DEPUTY.
model SosAlert {
  sosAlertId          String         @id @default(dbgenerated("gen_random_uuid()")) @map("sos_alert_id") @db.Uuid
  workspaceId         String         @map("workspace_id")
  triggeredByMemberId String         @map("triggered_by_member_id")
  deviceId            String?        @map("device_id") @db.Uuid
  sourceType          SosSourceType  @map("source_type")
  status              SosAlertStatus @default(ACTIVE) @map("status")
  severity            SosSeverity?   @map("severity")
  initialLatitude     Decimal?       @map("initial_latitude") @db.Decimal(10, 7)
  initialLongitude    Decimal?       @map("initial_longitude") @db.Decimal(10, 7)
  message             String?        @map("message")
  triggeredAt         DateTime       @default(now()) @map("triggered_at") @db.Timestamptz
  resolvedByMemberId  String?        @map("resolved_by_member_id")
  resolvedAt          DateTime?      @map("resolved_at") @db.Timestamptz
  resolutionNote      String?        @map("resolution_note")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  workspace         Family          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  triggeredByMember FamilyMember    @relation("TriggeredSosAlerts", fields: [triggeredByMemberId], references: [id], onDelete: Cascade)
  device            WearableDevice? @relation(fields: [deviceId], references: [deviceId], onDelete: SetNull)
  resolvedByMember  FamilyMember?   @relation("ResolvedSosAlerts", fields: [resolvedByMemberId], references: [id], onDelete: SetNull)

  locationPoints SosLocationPoint[]
  responses      SosResponse[]
  sensorEvents   SensorEvent[]      @relation("CreatedSosAlertSensorEvents")

  @@index([workspaceId])
  @@index([triggeredByMemberId])
  @@index([deviceId])
  @@index([status])
  @@index([triggeredAt])
  @@map("sos_alerts")
}

/// GPS route points captured during a single SOS event.
model SosLocationPoint {
  locationPointId String        @id @default(dbgenerated("gen_random_uuid()")) @map("location_point_id") @db.Uuid
  sosAlertId      String        @map("sos_alert_id") @db.Uuid
  deviceId        String?       @map("device_id") @db.Uuid
  latitude        Decimal       @map("latitude") @db.Decimal(10, 7)
  longitude       Decimal       @map("longitude") @db.Decimal(10, 7)
  accuracy        Decimal?      @map("accuracy") @db.Decimal(10, 2)
  sourceType      GpsSourceType @map("source_type")
  recordedAt      DateTime      @map("recorded_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  sosAlert SosAlert        @relation(fields: [sosAlertId], references: [sosAlertId], onDelete: Cascade)
  device   WearableDevice? @relation(fields: [deviceId], references: [deviceId], onDelete: SetNull)

  @@index([sosAlertId])
  @@index([deviceId])
  @@index([recordedAt])
  @@map("sos_location_points")
}

/// Member responses to a SOS alert (viewed / safe / need help / resolved / canceled).
model SosResponse {
  responseId        String          @id @default(dbgenerated("gen_random_uuid()")) @map("response_id") @db.Uuid
  sosAlertId        String          @map("sos_alert_id") @db.Uuid
  responderMemberId String          @map("responder_member_id")
  responseType      SosResponseType @map("response_type")
  message           String?         @map("message")
  respondedAt       DateTime        @default(now()) @map("responded_at") @db.Timestamptz

  sosAlert        SosAlert     @relation(fields: [sosAlertId], references: [sosAlertId], onDelete: Cascade)
  responderMember FamilyMember @relation("SosResponses", fields: [responderMemberId], references: [id], onDelete: Cascade)

  @@index([sosAlertId])
  @@index([responderMemberId])
  @@map("sos_responses")
}

/// Raw sensor events emitted by wearable / simulated devices.
model SensorEvent {
  sensorEventId     String          @id @default(dbgenerated("gen_random_uuid()")) @map("sensor_event_id") @db.Uuid
  deviceId          String          @map("device_id") @db.Uuid
  eventType         SensorEventType @map("event_type")
  rawValue          Json?           @map("raw_value") @db.JsonB
  severity          SosSeverity?    @map("severity")
  detectedAt        DateTime        @map("detected_at") @db.Timestamptz
  createdSosAlertId String?         @map("created_sos_alert_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  device          WearableDevice @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  createdSosAlert SosAlert?      @relation("CreatedSosAlertSensorEvents", fields: [createdSosAlertId], references: [sosAlertId], onDelete: SetNull)

  @@index([deviceId])
  @@index([createdSosAlertId])
  @@index([detectedAt])
  @@map("sensor_events")
}

/// Everyday member location tracking — separate from SOS-event route points.
model MemberLocationPoint {
  locationPointId String        @id @default(dbgenerated("gen_random_uuid()")) @map("location_point_id") @db.Uuid
  workspaceId     String        @map("workspace_id")
  memberId        String        @map("member_id")
  deviceId        String?       @map("device_id") @db.Uuid
  latitude        Decimal       @map("latitude") @db.Decimal(10, 7)
  longitude       Decimal       @map("longitude") @db.Decimal(10, 7)
  accuracy        Decimal?      @map("accuracy") @db.Decimal(10, 2)
  sourceType      GpsSourceType @map("source_type")
  recordedAt      DateTime      @map("recorded_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  workspace Family          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    FamilyMember    @relation("MemberLocationPoints", fields: [memberId], references: [id], onDelete: Cascade)
  device    WearableDevice? @relation(fields: [deviceId], references: [deviceId], onDelete: SetNull)

  // Plus CHECK constraints added via raw SQL in the migration:
  // latitude BETWEEN -90 AND 90, longitude BETWEEN -180 AND 180.
  @@index([workspaceId])
  @@index([memberId])
  @@index([deviceId])
  @@index([recordedAt])
  @@map("member_location_points")
}

/// Shared in-app notifications (reused across modules; SOS uses type=SOS).
model Notification {
  notificationId    String               @id @default(dbgenerated("gen_random_uuid()")) @map("notification_id") @db.Uuid
  familyId          String               @map("family_id")
  recipientMemberId String               @map("recipient_member_id")
  type              NotificationType     @map("type")
  priority          NotificationPriority @default(NORMAL) @map("priority")
  title             String               @map("title")
  body              String               @map("body")
  referenceType     String?              @map("reference_type")
  referenceId       String?              @map("reference_id")
  isRead            Boolean              @default(false) @map("is_read")
  readAt            DateTime?            @map("read_at") @db.Timestamptz
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz

  family          Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  recipientMember FamilyMember @relation("MemberNotifications", fields: [recipientMemberId], references: [id], onDelete: Cascade)

  @@index([recipientMemberId, isRead])
  @@index([familyId])
  @@map("notifications")
}
