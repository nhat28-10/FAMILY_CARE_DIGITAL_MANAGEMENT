  GENERAL
}

/// Provisioning/activation audit log của một family workspace (admin).
model WorkspaceProvisioningLog {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @map("provisioning_log_id") @db.Uuid
  workspaceId     String                 @map("workspace_id")
  actionType      ProvisioningActionType @map("action_type")
  status          ProvisioningStatus     @default(PENDING) @map("status")
  message         String?                @map("message")
  startedAt       DateTime?              @map("started_at") @db.Timestamptz
  finishedAt      DateTime?              @map("finished_at") @db.Timestamptz
  createdByUserId String?                @map("created_by_user_id")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz

  workspace     Family @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser User?  @relation("CreatedProvisioningLogs", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([createdByUserId])
  @@index([status])
  @@map("workspace_provisioning_logs")
}

/// Hội thoại nhóm/riêng trong một family workspace (chat).
model Conversation {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @map("conversation_id") @db.Uuid
  workspaceId       String             @map("workspace_id")
  conversationType  ConversationType   @default(GROUP) @map("conversation_type")
  conversationName  String?            @map("conversation_name")
  createdByMemberId String             @map("created_by_member_id")
  status            ConversationStatus @default(ACTIVE) @map("status")
  /// Nhóm chat chung mặc định của family (duy nhất 1/workspace — partial unique index trong migration).
  isDefault         Boolean            @default(false) @map("is_default")
  /// Dedupe chat 1-1: "<memberIdNhỏ>:<memberIdLớn>" (sort 2 memberId). GROUP = null.
  directKey         String?            @unique @map("direct_key")
  /// Thời điểm tin nhắn cuối — sort danh sách hội thoại.
  lastMessageAt     DateTime?          @map("last_message_at") @db.Timestamptz
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz

  workspace       Family       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByMember FamilyMember @relation("CreatedConversations", fields: [createdByMemberId], references: [id], onDelete: Restrict)

  participants ConversationParticipant[]
  messages     Message[]
  calls        Call[]

  @@index([workspaceId])
  @@index([createdByMemberId])
  @@map("conversations")
}

/// Thành viên tham gia một hội thoại.
model ConversationParticipant {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @map("participant_id") @db.Uuid
  conversationId    String            @map("conversation_id") @db.Uuid
  memberId          String            @map("member_id")
  joinedAt          DateTime          @default(now()) @map("joined_at") @db.Timestamptz
  leftAt            DateTime?         @map("left_at") @db.Timestamptz
  participantStatus ParticipantStatus @default(ACTIVE) @map("participant_status")
  /// Read receipt: đã đọc tới thời điểm này (đếm unread = message sentAt > lastReadAt).
  lastReadAt        DateTime?         @map("last_read_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  member       FamilyMember @relation("ConversationParticipations", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([conversationId, memberId])
  @@index([conversationId])
  @@index([memberId])
  @@map("conversation_participants")
}

/// Tin nhắn trong một hội thoại.
model Message {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @map("message_id") @db.Uuid
  conversationId   String      @map("conversation_id") @db.Uuid
  senderMemberId   String      @map("sender_member_id")
  messageType      MessageType @default(TEXT) @map("message_type")
  content          String?     @map("content")
  /// Reply/quote: tin nhắn được trả lời (cùng hội thoại).
  replyToMessageId String?     @map("reply_to_message_id") @db.Uuid
  /// Ghim tin nhắn trong hội thoại.
  pinnedAt         DateTime?   @map("pinned_at") @db.Timestamptz
  pinnedByMemberId String?     @map("pinned_by_member_id")
  /// Cuộc gọi liên quan (chỉ set khi messageType = CALL) — tin nhắn hệ thống ghi log cuộc gọi.
  relatedCallId    String?     @map("related_call_id") @db.Uuid
  sentAt           DateTime    @default(now()) @map("sent_at") @db.Timestamptz
  editedAt         DateTime?   @map("edited_at") @db.Timestamptz
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderMember   FamilyMember  @relation("SentMessages", fields: [senderMemberId], references: [id], onDelete: Cascade)
  replyTo        Message?      @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies        Message[]     @relation("MessageReplies")
  pinnedByMember FamilyMember? @relation("PinnedMessages", fields: [pinnedByMemberId], references: [id], onDelete: SetNull)
  relatedCall    Call?         @relation(fields: [relatedCallId], references: [id], onDelete: SetNull)

  attachments MessageAttachment[]
  reactions   MessageReaction[]

  @@index([conversationId, sentAt])
  @@index([senderMemberId])
  @@index([conversationId, pinnedAt])
  @@map("messages")
}

/// Cuộc gọi video/audio trong một hội thoại (LiveKit room 1-1 hoặc nhóm).
model Call {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @map("call_id") @db.Uuid
  conversationId      String     @map("conversation_id") @db.Uuid
  initiatedByMemberId String     @map("initiated_by_member_id")
  /// Tên phòng LiveKit, dạng `call-<uuid>`.
  roomName            String     @unique @map("room_name")
  status              CallStatus @default(RINGING) @map("status")
  startedAt           DateTime   @default(now()) @map("started_at") @db.Timestamptz
  /// Thời điểm người đầu tiên join phòng (khác startedAt = lúc bắt đầu đổ chuông).
  connectedAt         DateTime?  @map("connected_at") @db.Timestamptz
  endedAt             DateTime?  @map("ended_at") @db.Timestamptz
  /// 'hangup' | 'timeout' | 'all_left'.
  endedReason         String?    @map("ended_reason")

  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  initiatedByMember FamilyMember      @relation("InitiatedCalls", fields: [initiatedByMemberId], references: [id], onDelete: Restrict)
  participants      CallParticipant[]
  relatedMessages   Message[]

  @@index([conversationId, startedAt])
  @@map("calls")
}

/// Thành viên tham gia (được mời/đã join/đã rời) một cuộc gọi.
model CallParticipant {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @map("call_participant_id") @db.Uuid
  callId    String                @map("call_id") @db.Uuid
  memberId  String                @map("member_id")
  status    CallParticipantStatus @default(INVITED) @map("status")
  invitedAt DateTime              @default(now()) @map("invited_at") @db.Timestamptz
  joinedAt  DateTime?             @map("joined_at") @db.Timestamptz
  leftAt    DateTime?             @map("left_at") @db.Timestamptz

  call   Call         @relation(fields: [callId], references: [id], onDelete: Cascade)
  member FamilyMember @relation("CallParticipations", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([callId, memberId])
  @@index([callId])
  @@index([memberId])
  @@map("call_participants")
}

/// Reaction (thả cảm xúc) trên một tin nhắn.
model MessageReaction {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @map("reaction_id") @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  memberId  String   @map("member_id")
  emoji     String   @map("emoji")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  message Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member  FamilyMember @relation("MessageReactions", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messageId, memberId, emoji])
  @@index([messageId])
  @@index([memberId])
  @@map("message_reactions")
}

/// Tệp đính kèm của một tin nhắn.
model MessageAttachment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @map("attachment_id") @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  fileType   String   @map("file_type")
  fileUrl    String   @map("file_url")
  fileName   String?  @map("file_name")
  fileSize   Int?     @map("file_size")
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

/// Thông báo/announcement do member tạo trong family workspace.
model FamilyAnnouncement {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @map("announcement_id") @db.Uuid
  workspaceId       String               @map("workspace_id")
  createdByMemberId String               @map("created_by_member_id")
  title             String               @map("title")
  content           String               @map("content")
  priority          NotificationPriority @default(NORMAL) @map("priority")
  status            AnnouncementStatus   @default(ACTIVE) @map("status")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz

  workspace       Family       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByMember FamilyMember @relation("CreatedAnnouncements", fields: [createdByMemberId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([createdByMemberId])
  @@map("family_announcements")
}

/// Sự kiện lịch của family workspace.
model CalendarEvent {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  workspaceId       String              @map("workspace_id")
  title             String              @map("title")
  description       String?             @map("description")
  location          String?             @map("location")
  startTime         DateTime            @map("start_time") @db.Timestamptz
  endTime           DateTime?           @map("end_time") @db.Timestamptz
  isRecurring       Boolean             @default(false) @map("is_recurring")
  createdByMemberId String              @map("created_by_member_id")
  status            CalendarEventStatus @default(ACTIVE) @map("status")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz

  workspace       Family       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByMember FamilyMember @relation("CreatedCalendarEvents", fields: [createdByMemberId], references: [id], onDelete: Restrict)

  participants CalendarEventParticipant[]

  @@index([workspaceId])
  @@index([createdByMemberId])
  @@index([startTime])
  @@map("calendar_events")
}

/// Thành viên được mời tham gia một sự kiện lịch.
model CalendarEventParticipant {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @map("event_participant_id") @db.Uuid
  eventId         String              @map("event_id") @db.Uuid
  memberId        String              @map("member_id")
  responseStatus  EventResponseStatus @default(INVITED) @map("response_status")
  reminderEnabled Boolean             @default(true) @map("reminder_enabled")
  reminderSentAt  DateTime?           @map("reminder_sent_at") @db.Timestamptz

  event  CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member FamilyMember  @relation("CalendarEventParticipations", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@index([eventId])
  @@index([memberId])
  @@map("calendar_event_participants")
}

/// Ảnh/video trong album gia đình.
model AlbumCollection {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @map("collection_id") @db.Uuid
  workspaceId       String    @map("workspace_id")
  name              String    @map("name")
  description       String?   @map("description")
  coverMediaId      String?   @map("cover_media_id") @db.Uuid
  createdByMemberId String    @map("created_by_member_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  workspace       Family       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByMember FamilyMember @relation("CreatedAlbumCollections", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  coverMedia      AlbumMedia?  @relation("AlbumCollectionCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  media           AlbumMedia[] @relation("AlbumCollectionMedia")

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([createdByMemberId])
  @@map("album_collections")
}

model AlbumMedia {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @map("media_id") @db.Uuid
  workspaceId            String                @map("workspace_id")
  collectionId           String?               @map("collection_id") @db.Uuid
  uploadedByMemberId     String                @map("uploaded_by_member_id")
  mediaType              AlbumMediaType        @map("media_type")
  mediaUrl               String?               @map("media_url")
  storageKey             String?               @map("storage_key")
  originalFileName       String?               @map("original_file_name")
  mimeType               String?               @map("mime_type")
  fileSize               Int?                  @map("file_size")
  thumbnailUrl           String?               @map("thumbnail_url")
  caption                String?               @map("caption")
  visibilityScope        AlbumVisibilityScope  @default(FAMILY) @map("visibility_scope")
  moderationStatus       MediaModerationStatus @default(PENDING) @map("moderation_status")
  uploadedAt             DateTime              @default(now()) @map("uploaded_at") @db.Timestamptz
  updatedAt              DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt              DateTime?             @map("deleted_at") @db.Timestamptz
  deletedByMemberId      String?               @map("deleted_by_member_id")
  deleteReason           String?               @map("delete_reason")
  moderationStartedAt    DateTime?             @map("moderation_started_at") @db.Timestamptz
  moderationCompletedAt  DateTime?             @map("moderation_completed_at") @db.Timestamptz
  moderationAttemptCount Int                   @default(0) @map("moderation_attempt_count")
  lastModerationError    String?               @map("last_moderation_error")
  latestModerationJobId  String?               @map("latest_moderation_job_id") @db.Uuid
  moderationQueuedAt     DateTime?             @map("moderation_queued_at") @db.Timestamptz

  workspace          Family            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  collection         AlbumCollection?  @relation("AlbumCollectionMedia", fields: [collectionId], references: [id], onDelete: SetNull)
  coveredCollections AlbumCollection[] @relation("AlbumCollectionCover")
  uploadedByMember   FamilyMember      @relation("UploadedAlbumMedia", fields: [uploadedByMemberId], references: [id], onDelete: Cascade)
  deletedByMember    FamilyMember?     @relation("DeletedAlbumMedia", fields: [deletedByMemberId], references: [id], onDelete: SetNull)

  tags             AlbumMediaTag[]
  moderationChecks MediaModerationCheck[]
  cleanupJobs      StorageCleanupJob[]    @relation("MediaCleanupJobs")
  faceScanJobs     FaceScanJob[]
  faceDetections   AlbumFaceDetection[]
  tagSuggestions   AlbumTagSuggestion[]

  @@index([workspaceId])
  @@index([workspaceId, collectionId, uploadedAt])
  @@index([uploadedByMemberId])
  @@index([moderationStatus])
  @@index([workspaceId, uploadedAt])
  @@index([workspaceId, deletedAt, uploadedAt])
  @@index([workspaceId, moderationStatus, uploadedAt])
  @@index([moderationStatus, moderationStartedAt])
  @@index([moderationStatus, moderationQueuedAt])
  @@index([deletedByMemberId])
  @@map("album_media")
}

/// Tag gắn thành viên vào một media (manual tagging cho MVP).
model AlbumMediaTag {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @map("tag_id") @db.Uuid
  mediaId          String   @map("media_id") @db.Uuid
  taggedMemberId   String   @map("tagged_member_id")
  taggedByMemberId String   @map("tagged_by_member_id")
  tagNote          String?  @map("tag_note")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  media          AlbumMedia   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  taggedMember   FamilyMember @relation("TaggedAlbumMediaTags", fields: [taggedMemberId], references: [id], onDelete: Cascade)
  taggedByMember FamilyMember @relation("CreatedAlbumMediaTags", fields: [taggedByMemberId], references: [id], onDelete: Cascade)

  @@unique([mediaId, taggedMemberId])
  @@index([mediaId])
  @@index([taggedMemberId])
  @@index([taggedByMemberId])
  @@map("album_media_tags")
}

/// Async scan record for album face detection and workspace-scoped matching.
model FaceScanJob {
  scanJobId           String            @id @default(dbgenerated("gen_random_uuid()")) @map("scan_job_id") @db.Uuid
  workspaceId         String            @map("workspace_id")
  mediaId             String            @map("media_id") @db.Uuid
  requestedByMemberId String            @map("requested_by_member_id")
  status              FaceScanJobStatus @default(PENDING) @map("status")
  attemptCount        Int               @default(0) @map("attempt_count")
  lastError           String?           @map("last_error")
  startedAt           DateTime?         @map("started_at") @db.Timestamptz
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  workspace         Family               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  media             AlbumMedia           @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  requestedByMember FamilyMember         @relation("RequestedFaceScanJobs", fields: [requestedByMemberId], references: [id], onDelete: Restrict)
  detections        AlbumFaceDetection[]

  @@index([workspaceId])
  @@index([mediaId])
  @@index([workspaceId, mediaId, createdAt])
  @@index([status, startedAt])
  @@map("face_scan_jobs")
}

/// Face detected in an album photo. No plaintext biometric embedding is stored.
model AlbumFaceDetection {
  detectionId    String                   @id @default(dbgenerated("gen_random_uuid()")) @map("detection_id") @db.Uuid
  workspaceId    String                   @map("workspace_id")
  scanJobId      String                   @map("scan_job_id") @db.Uuid
  mediaId        String                   @map("media_id") @db.Uuid
  faceIndex      Int                      @map("face_index")
  boundingBox    Json                     @map("bounding_box")
  detectionScore Decimal?                 @map("detection_score") @db.Decimal(5, 4)
  qualityScore   Decimal?                 @map("quality_score") @db.Decimal(5, 4)
  modelName      String                   @map("model_name")
  modelVersion   String                   @map("model_version")
  status         AlbumFaceDetectionStatus @default(UNMATCHED) @map("status")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  workspace   Family               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scanJob     FaceScanJob          @relation(fields: [scanJobId], references: [scanJobId], onDelete: Cascade)
  media       AlbumMedia           @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  suggestions AlbumTagSuggestion[]

  @@unique([scanJobId, faceIndex])
  @@index([workspaceId])
  @@index([mediaId])
  @@index([workspaceId, mediaId])
  @@map("album_face_detections")
}

/// Human-confirmed candidate tag proposed from a face detection.
model AlbumTagSuggestion {
  suggestionId        String                   @id @default(dbgenerated("gen_random_uuid()")) @map("suggestion_id") @db.Uuid
  workspaceId         String                   @map("workspace_id")
  detectionId         String                   @map("detection_id") @db.Uuid
  mediaId             String                   @map("media_id") @db.Uuid
  suggestedMemberId   String                   @map("suggested_member_id")
  similarityScore     Decimal                  @map("similarity_score") @db.Decimal(5, 4)
  secondBestScore     Decimal?                 @map("second_best_score") @db.Decimal(5, 4)
  scoreMargin         Decimal?                 @map("score_margin") @db.Decimal(5, 4)
  status              AlbumTagSuggestionStatus @default(PENDING) @map("status")
  confirmedByMemberId String?                  @map("confirmed_by_member_id")
  confirmedAt         DateTime?                @map("confirmed_at") @db.Timestamptz
  rejectedByMemberId  String?                  @map("rejected_by_member_id")
  rejectedAt          DateTime?                @map("rejected_at") @db.Timestamptz
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  workspace         Family             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  detection         AlbumFaceDetection @relation(fields: [detectionId], references: [detectionId], onDelete: Cascade)
  media             AlbumMedia         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  suggestedMember   FamilyMember       @relation("SuggestedAlbumTagSuggestions", fields: [suggestedMemberId], references: [id], onDelete: Restrict)
  confirmedByMember FamilyMember?      @relation("ConfirmedAlbumTagSuggestions", fields: [confirmedByMemberId], references: [id], onDelete: SetNull)
  rejectedByMember  FamilyMember?      @relation("RejectedAlbumTagSuggestions", fields: [rejectedByMemberId], references: [id], onDelete: SetNull)

  @@unique([detectionId, suggestedMemberId])
  @@index([workspaceId])
  @@index([mediaId])
  @@index([workspaceId, mediaId])
  @@index([suggestedMemberId, status])
  @@map("album_tag_suggestions")
}

/// Durable retry record for R2/database cleanup; never stores signed URLs or credentials.
model StorageCleanupJob {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @map("cleanup_job_id") @db.Uuid
  workspaceId  String?              @map("workspace_id")
  mediaId      String?              @map("media_id") @db.Uuid
  storageKey   String               @unique @map("storage_key")
  reason       StorageCleanupReason @map("reason")
  status       StorageCleanupStatus @default(PENDING) @map("status")
  attemptCount Int                  @default(0) @map("attempt_count")
  lastError    String?              @map("last_error")
  nextRetryAt  DateTime?            @default(now()) @map("next_retry_at") @db.Timestamptz
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  workspace Family?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  media     AlbumMedia? @relation("MediaCleanupJobs", fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([status, nextRetryAt])
  @@index([workspaceId])
  @@index([mediaId])
  @@map("storage_cleanup_jobs")
}

/// Kết quả kiểm duyệt nội dung media (future/demo: face grouping, sensitive content).
model MediaModerationCheck {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @map("moderation_id") @db.Uuid
  mediaId            String           @map("media_id") @db.Uuid
  jobId              String?          @unique @map("job_id") @db.Uuid
  checkType          MediaCheckType   @map("check_type")
  provider           String?          @map("provider")
  modelName          String?          @map("model_name")
  resultStatus       MediaCheckResult @map("result_status")
  confidenceScore    Decimal?         @map("confidence_score") @db.Decimal(5, 4)
  categories         Json?            @map("categories")
  reasonCode         String?          @map("reason_code")
  summary            String?          @map("summary")
  errorCode          String?          @map("error_code")
  errorMessage       String?          @map("error_message")
  reviewedByMemberId String?          @map("reviewed_by_member_id")
  reviewNote         String?          @map("review_note")
  reviewedAt         DateTime?        @map("reviewed_at") @db.Timestamptz
  checkedAt          DateTime         @default(now()) @map("checked_at") @db.Timestamptz
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz

  media            AlbumMedia    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  reviewedByMember FamilyMember? @relation("ReviewedModerationChecks", fields: [reviewedByMemberId], references: [id], onDelete: SetNull)

  @@index([mediaId])
  @@index([mediaId, checkedAt])
  @@index([checkType])
  @@index([reviewedByMemberId])
  @@map("media_moderation_checks")
}

/// Consent-backed face profile for a family member. Stores metadata only; biometric vectors live encrypted in MemberFaceEmbedding.
model MemberFaceProfile {
  profileId           String            @id @default(dbgenerated("gen_random_uuid()")) @map("profile_id") @db.Uuid
  workspaceId         String            @map("workspace_id")
  memberId            String            @map("member_id")
  status              FaceProfileStatus @default(ACTIVE) @map("status")
  consentedAt         DateTime          @map("consented_at") @db.Timestamptz
  consentedByMemberId String            @map("consented_by_member_id")
  modelName           String            @map("model_name")
  modelVersion        String            @map("model_version")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime?         @map("deleted_at") @db.Timestamptz

  workspace         Family                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member            FamilyMember          @relation("MemberFaceProfiles", fields: [memberId], references: [id], onDelete: Cascade)
  consentedByMember FamilyMember          @relation("ConsentedFaceProfiles", fields: [consentedByMemberId], references: [id], onDelete: Restrict)
  embeddings        MemberFaceEmbedding[]

  @@unique([workspaceId, memberId])
  @@index([workspaceId])
  @@index([memberId])
  @@index([consentedByMemberId])
  @@index([status])
  @@map("member_face_profiles")
}

/// Encrypted face embedding sample. Plaintext embedding values are never stored.
model MemberFaceEmbedding {
  embeddingId        String    @id @default(dbgenerated("gen_random_uuid()")) @map("embedding_id") @db.Uuid
  profileId          String    @map("profile_id") @db.Uuid
  encryptedEmbedding Bytes     @map("encrypted_embedding")
  encryptionIv       Bytes     @map("encryption_iv")
  encryptionAuthTag  Bytes     @map("encryption_auth_tag")
  embeddingDimension Int       @map("embedding_dimension")
  detectionScore     Decimal?  @map("detection_score") @db.Decimal(5, 4)
  qualityScore       Decimal?  @map("quality_score") @db.Decimal(5, 4)
  modelName          String    @map("model_name")
  modelVersion       String    @map("model_version")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz

  profile MemberFaceProfile @relation(fields: [profileId], references: [profileId], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, revokedAt])
  @@map("member_face_embeddings")
}

/// Phiên hội thoại với AI assistant (theo từng member trong workspace).
model AIConversation {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @map("ai_conversation_id") @db.Uuid
  workspaceId       String   @map("workspace_id")
  memberId          String   @map("member_id")
  conversationTitle String?  @map("conversation_title")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Family       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    FamilyMember @relation("MemberAIConversations", fields: [memberId], references: [id], onDelete: Cascade)

  messages AIMessage[]

  @@index([workspaceId])
  @@index([memberId])
  @@map("ai_conversations")
}

/// Tin nhắn trong một phiên AIConversation.
model AIMessage {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @map("ai_message_id") @db.Uuid
  aiConversationId  String           @map("ai_conversation_id") @db.Uuid
  senderType        AiSenderType     @map("sender_type")
  messageContent    String           @map("message_content")
  relatedModule     AiRelatedModule? @map("related_module")
  permissionContext Json?            @map("permission_context")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz

  aiConversation AIConversation @relation(fields: [aiConversationId], references: [id], onDelete: Cascade)

  @@index([aiConversationId])
  @@map("ai_messages")
}
